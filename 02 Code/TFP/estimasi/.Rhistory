aes(x = Year, y = idx, color = komponen, label = fmt_id(idx, 1)),
hjust = -0.25, size = 2.6, show.legend = FALSE) +
scale_color_manual(values = kum_col) +
scale_x_continuous(breaks = 2017:2024,
expand = expansion(mult = c(0.03, 0.10))) +
scale_y_continuous(labels = lab_id(0), breaks = seq(95, 120, 5)) +
coord_cartesian(ylim = c(95, 121)) +
labs(
title    = "Kontribusi kumulatif modal, tenaga kerja, dan TFP terhadap pertumbuhan, 2017 = 100",
subtitle = paste0("Tiga indeks sebanding, masing-masing dinormalkan ke 100 pada 2017. Garis modal dan tenaga kerja adalah kontribusi\n",
"kumulatif input berbobot elastisitas non-CRS (b1 = 0,400; b2 = 0,191); garis TFP adalah indeks efek tahun model utama."),
x        = NULL,
y        = "Indeks kontribusi (2017 = 100)",
caption  = paste0(
"Cara baca: ketiga garis adalah indeks yang sebanding tetapi TIDAK menjumlah ke output, sehingga ini bukan dekomposisi bertumpuk.\n",
"Basis pembobotannya pun berbeda: garis modal dan tenaga kerja dari agregat nasional (berbobot output), garis TFP dari panel\n",
"provinsi (tiap provinsi berbobot sama), sehingga keduanya tidak boleh dibaca sebagai dua ukuran atas objek yang sama.\n",
"Garis TFP memakai efek tahun, bukan sisa identitas per tahun, karena dekomposisi tahun-per-tahun tidak sah ketika rasio\n",
"investasi terhadap stok tidak stabil, terutama pada guncangan 2020-2021. Pita = selang kepercayaan 95 persen garis TFP.\n",
sumber_txt)
) +
tema_rumah
ggsave(file.path(dir_out, "Kontribusi Kumulatif Faktor.png"), p8,
width = 7.5, height = 4.8, units = "in", dpi = 300, bg = "white")
cat("Selesai: 8 PNG tersimpan di", dir_out, "\n")
# SCRIPT OVERVIEW --------------------------------------
# Visualisasi hasil estimasi TFP & dekomposisi pertumbuhan nasional.
# Input  : 03 Output/Hasil Estimasi TFP.xlsx, 03 Output/Dekomposisi Nasional.xlsx
# Output : 8 PNG di 03 Output/
#   1) Dekomposisi Pertumbuhan Nasional.png
#   2) Indeks TFP Nasional.png
#   3) Peringkat TFP Provinsi.png
#   4) Tangga Atenuasi Elastisitas.png
#   5) Amplop Sisa vs Elastisitas Modal.png
#   6) Dekomposisi per Pulau.png
#   7) Indeks TFP per Pulau.png
#   8) Kontribusi Kumulatif Faktor.png
# CATATAN: skrip ini TIDAK menghitung ulang apa pun, hanya membaca hasil.
# 1) Persiapan ----
rm(list = ls())
suppressPackageStartupMessages({
library(openxlsx)
library(dplyr)
library(tidyr)
library(ggplot2)
library(scales)
})
dir_out <- "C:/Users/ASUS/OneDrive/KeRjAaaAAAaaAaAAA/Project 2026 (JOGJA)/2026-BKPM-analisis kebijakan makro akselerasi investasi/BKPM-local/TFP calc/TFP analysis (07182026)/03 Output"
f_tfp   <- file.path(dir_out, "Hasil Estimasi TFP.xlsx")
f_dek   <- file.path(dir_out, "Dekomposisi Nasional.xlsx")
## palet rumah ----
mega_colors  <- c("Modal"              = "#0E2440",
"Tenaga kerja"       = "#797F8C",
"Sisa (TFP + galat)" = "#5DD0E6")
aksen        <- "#D9042B"
netral_gelap <- "#062E4C"
netral_sedang<- "#797F8C"
pulau_colors <- c("Sumatera"     = "#F2E6CE",
"Jawa"         = "#F2509C",
"Bali-Nusra"   = "#D9042B",
"Kalimantan"   = "#062E4C",
"Sulawesi"     = "#30726A",
"Maluku-Papua" = "#46A694")
# warna garis: sama dengan pulau_colors, kecuali Sumatera yang krem terang
# sehingga tidak terbaca sebagai garis di atas latar putih -> dipakai versi lebih gelap
pulau_lines <- pulau_colors
pulau_lines[["Sumatera"]] <- "#A68B4B"
sumber_txt <- "Sumber: BPS & BKPM, diolah."
## tema rumah ----
tema_rumah <- theme_classic(base_size = 10) +
theme(
plot.title          = element_text(face = "bold", size = 11),
plot.subtitle       = element_text(size = 9, color = "grey30"),
plot.caption        = element_text(color = "grey50", size = 8, hjust = 0),
plot.caption.position = "plot",
plot.title.position = "plot",
panel.grid.major.y  = element_line(color = "grey90", linewidth = 0.4),
strip.background    = element_blank(),
strip.text          = element_text(face = "bold", size = 9),
legend.position     = "bottom",
legend.title        = element_blank(),
legend.key.size     = unit(0.4, "cm"),
legend.text         = element_text(size = 8.5),
axis.title          = element_text(size = 9),
plot.margin         = margin(10, 14, 8, 10)
)
## format angka Indonesia ----
fmt_id <- function(x, d = 2) formatC(x, format = "f", digits = d, decimal.mark = ",")
lab_id <- function(d = 1) function(x) formatC(x, format = "f", digits = d, decimal.mark = ",")
# 2) GAMBAR 1: Dekomposisi pertumbuhan nasional ----
dek <- read.xlsx(f_dek, sheet = "dekomposisi")
# F (tanpa CRS) adalah basis UTAMA dan ditaruh paling kiri; A/B/D/E hanya pembanding.
# skenario C dikeluarkan: kontribusi modal 134 persen dari pertumbuhan, tidak masuk akal
# secara ekonomi dan mendominasi skala sumbu sehingga skenario lain tidak terbaca.
urut_skenario <- c("F. Tanpa CRS", "A. Level (CRS)", "B. Growth (CRS)",
"D. Alfa baku 1/3", "E. PIM (CRS)")
lab_skenario  <- c("F. Tanpa CRS\n(UTAMA)", "A. Level\n(CRS)", "B. Growth\n(CRS)",
"D. Alfa\nbaku 1/3", "E. PIM\n(CRS)")
dek1 <- dek %>% filter(skenario %in% urut_skenario)
g1_long <- dek1 %>%
transmute(skenario,
gY,
`Modal`              = kontrib_K,
`Tenaga kerja`       = kontrib_L,
`Sisa (TFP + galat)` = sisa) %>%
pivot_longer(c(`Modal`, `Tenaga kerja`, `Sisa (TFP + galat)`),
names_to = "komponen", values_to = "nilai") %>%
mutate(skenario = factor(skenario, levels = urut_skenario),
komponen = factor(komponen, levels = names(mega_colors)))
# stacking manual: segmen positif naik dari 0, segmen negatif turun dari 0
g1_long <- g1_long %>%
arrange(skenario, komponen) %>%
group_by(skenario) %>%
mutate(
pos_cum = cumsum(ifelse(nilai > 0, nilai, 0)),
neg_cum = cumsum(ifelse(nilai < 0, nilai, 0)),
ymax    = ifelse(nilai > 0, pos_cum, neg_cum - nilai),
ymin    = ifelse(nilai > 0, pos_cum - nilai, neg_cum)
) %>%
ungroup() %>%
mutate(x = as.integer(skenario))
g1_tot <- dek1 %>%
transmute(skenario, gY) %>%
mutate(skenario = factor(skenario, levels = urut_skenario)) %>%
mutate(x = as.integer(skenario))
lab_sisa <- g1_long %>% filter(komponen == "Sisa (TFP + galat)")
p1 <- ggplot() +
geom_hline(yintercept = 0, color = "grey40", linewidth = 0.4) +
geom_rect(data = g1_long,
aes(xmin = x - 0.34, xmax = x + 0.34, ymin = ymin, ymax = ymax,
fill = komponen)) +
geom_segment(data = g1_tot,
aes(x = x - 0.40, xend = x + 0.40, y = gY, yend = gY),
color = aksen, linewidth = 0.6) +
geom_point(data = g1_tot, aes(x = x, y = gY),
color = aksen, size = 1.9, shape = 18) +
geom_text(data = lab_sisa,
aes(x = x, y = ifelse(nilai >= 0, ymax + 0.22, ymin - 0.22),
label = fmt_id(nilai, 2)),
size = 2.6, color = netral_gelap) +
scale_fill_manual(values = mega_colors) +
scale_x_continuous(breaks = 1:5, labels = lab_skenario,
limits = c(0.45, 5.55), expand = c(0, 0)) +
scale_y_continuous(labels = lab_id(1), breaks = seq(-1, 4, 0.5),
limits = c(-0.55, 4.35), expand = c(0, 0)) +
labs(
title    = "Dekomposisi pertumbuhan PDRB riil nasional menurut sumber pertumbuhan",
subtitle = paste0("Kontribusi modal, tenaga kerja, dan sisa (TFP + galat) dalam poin persen, periode 2018-2024.\n",
"Basis UTAMA = skenario F (tanpa CRS, b1 = 0,400; b2 = 0,191); A/B/D/E hanya pembanding.\n",
"Garis merah = pertumbuhan PDRB riil aktual (gY = 3,83); angka di ujung batang = nilai sisa."),
x        = NULL,
y        = "Kontribusi terhadap pertumbuhan (poin persen)",
caption  = paste0(
"Catatan: batang bertumpuk; segmen bernilai negatif digambar turun di bawah nol sehingga tinggi total batang tidak selalu sama dengan gY.\n",
"Basis UTAMA (F) tidak memaksakan skala hasil konstan, sehingga sisanya (0,98 poin) memuat suku skala (1-b1-b2) x pertumbuhan input.\n",
"Skenario C (pangsa pendapatan terukur) tidak ditampilkan karena kontribusi modalnya mencapai 134 persen dari pertumbuhan.\n",
"Sisa merupakan residual Solow, yaitu TFP bercampur galat pengukuran modal dan tenaga kerja, bukan TFP murni.\n",
sumber_txt)
) +
tema_rumah +
theme(axis.text.x = element_text(size = 8, lineheight = 0.95))
ggsave(file.path(dir_out, "Dekomposisi Pertumbuhan Nasional.png"), p1,
width = 7.5, height = 5.2, units = "in", dpi = 300, bg = "white")
# 3) GAMBAR 2: Indeks TFP nasional ----
efek <- read.xlsx(f_tfp, sheet = "efek_tahun") %>%
mutate(lo_idx = 100 * exp(lo),
hi_idx = 100 * exp(hi))
p2 <- ggplot(efek, aes(x = Year, y = indeks_100)) +
geom_hline(yintercept = 100, linetype = "dashed",
color = netral_sedang, linewidth = 0.4) +
geom_ribbon(aes(ymin = lo_idx, ymax = hi_idx), fill = mega_colors[["Sisa (TFP + galat)"]],
alpha = 0.35) +
geom_line(color = aksen, linewidth = 0.8) +
geom_point(color = aksen, size = 1.8) +
geom_text(aes(label = fmt_id(indeks_100, 1)), vjust = -1.5,
size = 2.6, color = netral_gelap) +
scale_x_continuous(breaks = 2017:2024, expand = expansion(mult = c(0.03, 0.04))) +
scale_y_continuous(labels = lab_id(0), breaks = seq(96, 114, 2)) +
coord_cartesian(ylim = c(97, 115)) +
labs(
title    = "Indeks produktivitas faktor total (TFP) nasional, 2017 = 100",
subtitle = paste0("Model TWFE (C.I. 95%)"),
x        = NULL,
y        = "Indeks TFP (2017 = 100)"
) +
tema_rumah
ggsave(file.path(dir_out, "Indeks TFP Nasional.png"), p2,
width = 7.5, height = 4.5, units = "in", dpi = 300, bg = "white")
# 4) GAMBAR 3: Peringkat TFP provinsi ----
prov_ekstraktif <- c("Kalimantan Timur", "Riau", "Papua Barat", "Kalimantan Utara",
"Kep.Riau", "Jambi", "Papua", "Kep.Bangka Belitung",
"Kalimantan Selatan", "Sumatera Selatan")
kel_colors <- c("Ekstraktif / enklave sumber daya" = "#D9042B",
"DKI Jakarta (artefak pencatatan)" = "#062E4C",
"Provinsi lain"                    = "#797F8C")
prov <- read.xlsx(f_tfp, sheet = "tfp_provinsi") %>%
mutate(kelompok = case_when(
Pre_Prov == "DKI Jakarta"        ~ "DKI Jakarta (artefak pencatatan)",
Pre_Prov %in% prov_ekstraktif    ~ "Ekstraktif / enklave sumber daya",
TRUE                             ~ "Provinsi lain"),
kelompok = factor(kelompok, levels = names(kel_colors)),
Pre_Prov = ifelse(Pre_Prov == "DI yogyakarta", "DI Yogyakarta", Pre_Prov),
Pre_Prov = gsub("^Kep\\.", "Kep. ", Pre_Prov)) %>%
arrange(dev_nasional) %>%
mutate(Pre_Prov = factor(Pre_Prov, levels = Pre_Prov))
p3 <- ggplot(prov, aes(x = dev_nasional, y = Pre_Prov)) +
geom_vline(xintercept = 0, color = netral_sedang, linewidth = 0.45) +
geom_segment(aes(x = 0, xend = dev_nasional, yend = Pre_Prov),
color = "grey85", linewidth = 0.35) +
geom_point(aes(color = kelompok), size = 2.4) +
geom_text(aes(label = fmt_id(dev_nasional, 2),
hjust = ifelse(dev_nasional >= 0, -0.35, 1.35)),
size = 2.5, color = "grey45") +
scale_color_manual(values = kel_colors, drop = FALSE) +
scale_x_continuous(labels = lab_id(1), breaks = seq(-0.8, 1.2, 0.2),
limits = c(-1.05, 1.55), expand = c(0, 0)) +
labs(
title    = "Peringkat produktivitas faktor total (TFP) antarprovinsi, rata-rata 2017-2024",
subtitle = paste0("Deviasi log TFP tiap provinsi terhadap rata-rata 34 provinsi.\n",
"Deviasi dipakai karena level log TFP berkisar 13,5 di semua provinsi sehingga perbedaannya tidak terbaca bila digambar dari nol."),
x        = "Deviasi log TFP dari rata-rata nasional",
y        = NULL,
caption  = paste0(
"Catatan: selisih 0,10 satuan log setara sekitar 10 persen perbedaan tingkat TFP.\n",
"Provinsi dengan kandungan sumber daya alam besar cenderung berada di atas karena nilai tambah\n",
"tambang dan migas masuk ke output tanpa tambahan tenaga kerja yang sebanding.\n",
"Level TFP karena itu memuat endowmen sumber daya alam dan komposisi sektor, bukan semata efisiensi teknis.\n",
"DKI Jakarta merupakan kasus khusus: PDRB dicatat menurut lokasi kerja sedangkan tenaga kerja menurut tempat tinggal,\n",
"sehingga output pekerja komuter masuk ke Jakarta tetapi pekerjanya tercatat di provinsi penyangga.\n",
sumber_txt)
) +
tema_rumah +
theme(panel.grid.major.y = element_blank(),
panel.grid.major.x = element_line(color = "grey90", linewidth = 0.4),
axis.text.y = element_text(size = 8),
axis.line.y = element_blank(),
axis.ticks.y = element_blank())
ggsave(file.path(dir_out, "Peringkat TFP Provinsi.png"), p3,
width = 8, height = 7, units = "in", dpi = 300, bg = "white")
# 5) GAMBAR 4: Tangga atenuasi elastisitas ----
tangga <- read.xlsx(f_tfp, sheet = "tangga_atenuasi")
urut_spek <- tangga$spesifikasi   # urutan mengikuti baris data, bukan alfabetis
# baris kedua label dipendekkan & dipatah agar tidak saling tumpang tindih
lab_var   <- c("variasi dibuang:\ntidak ada",
"variasi dibuang:\nsebagian\nantar-provinsi",
"variasi dibuang:\nseluruh\nantar-provinsi",
"variasi dibuang:\nantar-provinsi\n+ antar-tahun")
lab_spek  <- paste0(tangga$spesifikasi, "\n", lab_var)
tangga <- tangga %>%
mutate(spesifikasi = factor(spesifikasi, levels = urut_spek),
x = as.integer(spesifikasi))
tangga_long <- tangga %>%
transmute(spesifikasi, x,
`Modal` = b1, `Tenaga kerja` = b2) %>%
pivot_longer(c(`Modal`, `Tenaga kerja`), names_to = "komponen", values_to = "nilai") %>%
mutate(komponen = factor(komponen, levels = c("Modal", "Tenaga kerja")))
p4 <- ggplot() +
geom_col(data = tangga_long,
aes(x = x, y = nilai, fill = komponen),
width = 0.6, position = position_stack(reverse = TRUE)) +
geom_hline(yintercept = 1, linetype = "dashed", color = aksen, linewidth = 0.5) +
annotate("text", x = 4.45, y = 1.045, label = "CRS = 1,0",
color = aksen, size = 2.9, hjust = 1, fontface = "bold") +
geom_line(data = tangga, aes(x = x, y = rts), color = aksen, linewidth = 0.7) +
geom_point(data = tangga, aes(x = x, y = rts), color = aksen, size = 2.4) +
geom_label(data = tangga, aes(x = x, y = rts, label = fmt_id(rts, 3)),
vjust = -0.55, size = 2.7, color = aksen, linewidth = 0,
fill = "white", label.padding = unit(0.08, "lines")) +
scale_fill_manual(values = mega_colors[c("Modal", "Tenaga kerja")],
labels = c("Modal (b1)", "Tenaga kerja (b2)")) +
scale_x_continuous(breaks = 1:4, labels = lab_spek,
limits = c(0.5, 4.5), expand = c(0, 0)) +
scale_y_continuous(labels = lab_id(1), breaks = seq(0, 1.2, 0.2),
limits = c(0, 1.24), expand = c(0, 0)) +
labs(
title    = "Tangga atenuasi: skala hasil menurun seiring makin banyak variasi dibuang",
subtitle = paste0("Jumlah elastisitas b1 + b2 pada empat spesifikasi panel; titik dan garis merah menunjukkan b1 + b2."),
x        = NULL,
y        = "Jumlah elastisitas b1 + b2",
caption  = paste0(
"Cara baca: penurunan berurutan dari 1,011 ke 0,591 adalah pola khas atenuasi\n",
"akibat galat pengukuran (measurement error). Setiap kali variasi antarprovinsi lalu\n",
"antartahun dibuang, sinyal yang tersisa mengecil sementara galatnya tetap, sehingga\n",
"koefisien tertarik ke nol. Pola ini bukan bukti skala hasil menurun (DRS).\n",
sumber_txt)
) +
tema_rumah +
theme(axis.text.x = element_text(size = 7.4, lineheight = 1.05))
ggsave(file.path(dir_out, "Tangga Atenuasi Elastisitas.png"), p4,
width = 7, height = 5.2, units = "in", dpi = 300, bg = "white")
# 6) GAMBAR 5: Amplop sisa vs elastisitas modal ----
# Di bawah CRS (b2 = 1 - b1) dekomposisi kolaps jadi fungsi linear satu parameter:
#   sisa = gY - b1*gK - (1-b1)*gL = 1,75 - 4,05*b1
garis5 <- data.frame(b1 = seq(0, 1, by = 0.005)) %>%
mutate(sisa = 1.75 - 4.05 * b1)
# titik diberi kode pendek di grafik; nama lengkap ditaruh di blok keterangan
# agar tidak ada label yang bertumpuk di sekitar garis
titik5 <- data.frame(
kode  = c("P", "D", "B", "F", "A"),
b1    = c(0.299, 0.333, 0.364, 0.400, 0.446),
label = c("Panel berbobot", "Alfa baku 1/3", "Growth (CRS)",
"Tanpa CRS", "Level (CRS)")
) %>%
mutate(sisa = 1.75 - 4.05 * b1)
ket5 <- paste0(
paste0(titik5$kode, "  ", titik5$label, ": b1 = ", fmt_id(titik5$b1, 3),
"; sisa = ", fmt_id(titik5$sisa, 2)),
collapse = "\n")
amb <- 0.96   # 25 persen dari gY = 3,83
p5 <- ggplot() +
geom_hline(yintercept = 0, linetype = "dashed",
color = netral_sedang, linewidth = 0.45) +
geom_hline(yintercept = amb, linetype = "dashed",
color = aksen, linewidth = 0.45) +
geom_line(data = garis5, aes(x = b1, y = sisa),
color = netral_gelap, linewidth = 0.8) +
geom_point(data = titik5, aes(x = b1, y = sisa),
color = aksen, size = 2.4) +
geom_text(data = titik5, aes(x = b1 + 0.016, y = sisa + 0.075, label = kode),
hjust = 0, size = 2.8, fontface = "bold", color = aksen) +
annotate("text", x = 0.985, y = amb + 0.10,
label = "ambang 25 persen dari gY (sisa = 0,96)",
hjust = 1, size = 2.5, color = aksen) +
annotate("text", x = 0.985, y = 0.10, label = "sisa = 0 (seluruh pertumbuhan dari faktor)",
hjust = 1, size = 2.5, color = "grey45") +
annotate("text", x = 0.03, y = -0.35, label = ket5,
hjust = 0, vjust = 1, size = 2.5, color = netral_gelap, lineheight = 1.25) +
annotate("text", x = 0.03, y = -1.55,
label = paste0("Titik impas: sisa = 0 pada b1 = 0,433.\n",
"Sisa baru mencapai 25 persen dari gY bila b1 turun ke 0,196.\n",
"Seluruh estimasi (b1 = 0,299-0,446) berada di wilayah sisa kecil."),
hjust = 0, vjust = 1, size = 2.7, color = netral_gelap, lineheight = 1.2) +
scale_x_continuous(labels = lab_id(1), breaks = seq(0, 1, 0.1),
limits = c(0, 1), expand = c(0, 0)) +
scale_y_continuous(labels = lab_id(1), breaks = seq(-2.5, 2, 0.5),
limits = c(-2.45, 1.85), expand = c(0, 0)) +
labs(
# Judul sebelumnya berbunyi "berapa pun elastisitas modalnya, sisa tetap
# kecil" - dibantah oleh grafiknya sendiri, karena pada b1 = 0 sisa mencapai
# 1,75 poin (45,8% pertumbuhan). Yang benar: seluruh estimasi yang tersedia
# jatuh di wilayah sisa kecil, bukan seluruh nilai b1 yang mungkin.
title    = "Sisa mengecil seiring elastisitas modal, dan seluruh estimasi berada di wilayah sisa kecil",
subtitle = paste0("Di bawah asumsi skala hasil konstan (CRS) dekomposisi hanya bergantung pada satu parameter,\n",
"sehingga sisa = 1,75 - 4,05 x b1 untuk gY = 3,83; gK = 6,12; gL = 2,08."),
x        = "Elastisitas modal b1",
y        = "Sisa (poin persen)",
caption  = paste0(
"Cara baca: garis adalah seluruh kemungkinan nilai sisa di bawah CRS; titik merah adalah nilai b1 dari tiap skenario estimasi.\n",
"Skenario F diestimasi tanpa memaksakan CRS, sehingga posisinya di sini adalah padanan CRS dari b1 yang sama.\n",
sumber_txt)
) +
tema_rumah
ggsave(file.path(dir_out, "Amplop Sisa vs Elastisitas Modal.png"), p5,
width = 6.5, height = 4.5, units = "in", dpi = 300, bg = "white")
# 7) GAMBAR 6: Dekomposisi per pulau ----
dek_p <- read.xlsx(f_dek, sheet = "dekomposisi_pulau") %>%
filter(skenario == "F. Tanpa CRS")
urut_pulau6 <- dek_p %>% arrange(desc(sisa)) %>% pull(Pulau)
g6_long <- dek_p %>%
transmute(Pulau,
`Modal`              = kontrib_K,
`Tenaga kerja`       = kontrib_L,
`Sisa (TFP + galat)` = sisa) %>%
pivot_longer(-Pulau, names_to = "komponen", values_to = "nilai") %>%
mutate(Pulau    = factor(Pulau, levels = urut_pulau6),
komponen = factor(komponen, levels = names(mega_colors))) %>%
arrange(Pulau, komponen) %>%
group_by(Pulau) %>%
mutate(
pos_cum = cumsum(ifelse(nilai > 0, nilai, 0)),
neg_cum = cumsum(ifelse(nilai < 0, nilai, 0)),
ymax    = ifelse(nilai > 0, pos_cum, neg_cum - nilai),
ymin    = ifelse(nilai > 0, pos_cum - nilai, neg_cum)
) %>%
ungroup() %>%
mutate(x = as.integer(Pulau))
g6_tot <- dek_p %>%
transmute(Pulau, gY) %>%
mutate(Pulau = factor(Pulau, levels = urut_pulau6),
x     = as.integer(Pulau))
lab_sisa6 <- g6_long %>% filter(komponen == "Sisa (TFP + galat)")
p6 <- ggplot() +
geom_hline(yintercept = 0, color = "grey40", linewidth = 0.4) +
geom_rect(data = g6_long,
aes(xmin = x - 0.34, xmax = x + 0.34, ymin = ymin, ymax = ymax,
fill = komponen)) +
geom_segment(data = g6_tot,
aes(x = x - 0.40, xend = x + 0.40, y = gY, yend = gY),
color = aksen, linewidth = 0.6) +
geom_point(data = g6_tot, aes(x = x, y = gY),
color = aksen, size = 1.9, shape = 18) +
geom_text(data = lab_sisa6,
aes(x = x, y = ifelse(nilai >= 0, ymax + 0.24, ymin - 0.24),
label = fmt_id(nilai, 2)),
size = 2.6, color = netral_gelap) +
scale_fill_manual(values = mega_colors) +
scale_x_continuous(breaks = 1:6, labels = urut_pulau6,
limits = c(0.45, 6.55), expand = c(0, 0)) +
scale_y_continuous(labels = lab_id(1), breaks = seq(-2, 7, 1),
limits = c(-2.1, 6.9), expand = c(0, 0)) +
labs(
title    = "Dekomposisi pertumbuhan PDRB riil per pulau, 2018-2024",
subtitle = paste0("Skala produksi DRS: b1 = 0,400; b2 = 0,191), dalam poin persen.\n",
"Garis merah = pertumbuhan PDRB riil aktual (gY); angka di setiap bar = nilai TFP"),
x        = NULL,
y        = "Kontribusi terhadap pertumbuhan (poin persen)"
) +
tema_rumah +
theme(axis.text.x = element_text(size = 8.5))
ggsave(file.path(dir_out, "Dekomposisi per Pulau.png"), p6,
width = 8, height = 5, units = "in", dpi = 300, bg = "white")
# 8) GAMBAR 7: Indeks TFP per pulau (small multiples) ----
efek_p <- read.xlsx(f_tfp, sheet = "efek_tahun_pulau") %>%
mutate(lo_idx = 100 * exp(lo),
hi_idx = 100 * exp(hi))
urut_pulau7 <- names(pulau_colors)
lab_pulau7  <- efek_p %>%
distinct(Pulau, n_prov) %>%
mutate(lab = paste0(Pulau, " (", n_prov, " provinsi)"))
efek_p <- efek_p %>%
left_join(lab_pulau7, by = c("Pulau", "n_prov")) %>%
mutate(Pulau = factor(Pulau, levels = urut_pulau7),
lab   = factor(lab, levels = lab_pulau7$lab[match(urut_pulau7, lab_pulau7$Pulau)]))
p7 <- ggplot(efek_p, aes(x = Year, y = indeks_100)) +
geom_hline(yintercept = 100, linetype = "dashed",
color = netral_sedang, linewidth = 0.4) +
geom_ribbon(aes(ymin = lo_idx, ymax = hi_idx, fill = Pulau), alpha = 0.28) +
geom_line(aes(color = Pulau), linewidth = 0.8) +
geom_point(aes(color = Pulau), size = 1.4) +
facet_wrap(~ lab, nrow = 2) +
scale_color_manual(values = pulau_lines, guide = "none") +
scale_fill_manual(values = pulau_colors, guide = "none") +
scale_x_continuous(breaks = seq(2017, 2024, 2),
expand = expansion(mult = c(0.05, 0.05))) +
scale_y_continuous(labels = lab_id(0), breaks = seq(80, 160, 20)) +
coord_cartesian(ylim = c(83, 156)) +
labs(
title    = "Indeks TFP per pulau, 2017 = 100",
subtitle = paste0("Model TWFE diestimasi terpisah untuk tiap pulau (C.I 95)%"),
x        = NULL,
y        = "Indeks TFP (2017 = 100)"
) +
tema_rumah +
theme(panel.spacing = unit(0.8, "lines"))
ggsave(file.path(dir_out, "Indeks TFP per Pulau.png"), p7,
width = 9, height = 6, units = "in", dpi = 300, bg = "white")
# 9) GAMBAR 8: Kontribusi kumulatif per faktor over time ----
# Tiga INDEKS yang sebanding (2017 = 100), BUKAN dekomposisi bertumpuk:
#   - Modal & tenaga kerja: kontribusi kumulatif input berbobot elastisitas
#     non-CRS, dari agregat nasional (berbobot output) -> 100*exp(cumsum(b*g)).
#   - TFP: indeks efek tahun (panel, tiap provinsi berbobot sama), objek yang sah
#     untuk dimensi waktu, BUKAN residual identitas per tahun. Memakai efek tahun
#     inilah yang membuat grafik ini lolos aturan "jangan dekomposisi tahunan"
#     (Batasan 6): tidak ada sisa tahunan yang dihitung.
# Basis pembobotan modal/TK berbeda dari basis TFP (Batasan 10); ketiga garis
# TIDAK menjumlah ke output, dan garis output sengaja TIDAK ditampilkan supaya
# pembaca tidak tergoda mengurangkan output - modal - TK (dekomposisi terlarang).
par_tfp <- readRDS(file.path(dir_out, "parameter_terpilih.rds"))
b1_un   <- unname(par_tfp$b1_un)
b2_un   <- unname(par_tfp$b2_un)
seri <- read.xlsx(f_dek, sheet = "seri_nasional") %>%
arrange(Year) %>%
mutate(g_K0  = ifelse(is.na(g_K), 0, g_K),   # 2017 = tahun basis, pertumbuhan NA -> 0
g_L0  = ifelse(is.na(g_L), 0, g_L),
idx_K = 100 * exp(cumsum(b1_un * g_K0 / 100)),
idx_L = 100 * exp(cumsum(b2_un * g_L0 / 100)))
# warna: pinjam palet rumah; TFP memakai warna "Sisa" agar konsisten grafik lain
kum_col <- c("Modal"            = unname(mega_colors[["Modal"]]),
"Tenaga kerja"     = unname(mega_colors[["Tenaga kerja"]]),
"TFP (efek tahun)" = unname(mega_colors[["Sisa (TFP + galat)"]]))
# `efek` sudah dibaca di blok Gambar 2 (memuat indeks_100, lo_idx, hi_idx)
kum_garis <- bind_rows(
seri %>% transmute(Year, komponen = "Modal",            idx = idx_K),
seri %>% transmute(Year, komponen = "Tenaga kerja",     idx = idx_L),
efek %>% transmute(Year, komponen = "TFP (efek tahun)", idx = indeks_100)
) %>% mutate(komponen = factor(komponen, levels = names(kum_col)))
kum_lab <- kum_garis %>% filter(Year == max(Year))
p8 <- ggplot() +
geom_hline(yintercept = 100, linetype = "dashed",
color = netral_sedang, linewidth = 0.4) +
geom_ribbon(data = efek, aes(x = Year, ymin = lo_idx, ymax = hi_idx),
fill = mega_colors[["Sisa (TFP + galat)"]], alpha = 0.20) +
geom_line(data = kum_garis, aes(x = Year, y = idx, color = komponen),
linewidth = 0.8) +
geom_point(data = kum_garis, aes(x = Year, y = idx, color = komponen),
size = 1.5) +
geom_text(data = kum_lab,
aes(x = Year, y = idx, color = komponen, label = fmt_id(idx, 1)),
hjust = -0.25, size = 2.6, show.legend = FALSE) +
scale_color_manual(values = kum_col) +
scale_x_continuous(breaks = 2017:2024,
expand = expansion(mult = c(0.03, 0.10))) +
scale_y_continuous(labels = lab_id(0), breaks = seq(95, 120, 5)) +
coord_cartesian(ylim = c(95, 121)) +
labs(
title    = "Kontribusi kumulatif modal, tenaga kerja, dan TFP terhadap pertumbuhan, 2017 = 100",
subtitle = paste0("Tiga indeks sebanding, masing-masing dinormalkan ke 100 pada 2017. Garis modal dan tenaga kerja adalah kontribusi\n",
"kumulatif input berbobot elastisitas non-CRS (b1 = 0,400; b2 = 0,191); garis TFP adalah indeks efek tahun model utama."),
x        = NULL,
y        = "Indeks kontribusi (2017 = 100)",
caption  = paste0(
"Cara baca: ketiga garis adalah indeks yang sebanding tetapi TIDAK menjumlah ke output, sehingga ini bukan dekomposisi bertumpuk.\n",
"Basis pembobotannya pun berbeda: garis modal dan tenaga kerja dari agregat nasional (berbobot output), garis TFP dari panel\n",
"provinsi (tiap provinsi berbobot sama), sehingga keduanya tidak boleh dibaca sebagai dua ukuran atas objek yang sama.\n",
"Garis TFP memakai efek tahun, bukan sisa identitas per tahun, karena dekomposisi tahun-per-tahun tidak sah ketika rasio\n",
"investasi terhadap stok tidak stabil, terutama pada guncangan 2020-2021. Pita = selang kepercayaan 95 persen garis TFP.\n",
sumber_txt)
) +
tema_rumah
ggsave(file.path(dir_out, "Kontribusi Kumulatif Faktor.png"), p8,
width = 7.5, height = 4.8, units = "in", dpi = 300, bg = "white")
cat("Selesai: 8 PNG tersimpan di", dir_out, "\n")
