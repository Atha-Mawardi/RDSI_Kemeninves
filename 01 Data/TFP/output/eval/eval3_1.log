. *** 12. Robustness (headline FGLS on every equation) ----------------------------
. * RA  drops the last wave
. * RB  without Papua and Papua Barat (parent-province series across the 2022 split)
. * RC  investment = two-year mean of ln investment (t, t-1): smooths lumpy realisations
. * RD  investment = ln cumulative nominal realisation since first_year
. * RQ  dropped (duplicate of headline once pillars are already z-mean)
. * RT  with log_L (kanal tenaga kerja; headline tanpa log_L)
. if $run_robust {
.         foreach v in $invall {
  2.                 gen double sm_`v' = (`v' + L.`v') / 2
  3.                 label variable sm_`v' "two-year mean of `v'"
  4.         }
(34 missing values generated)
(34 missing values generated)
(34 missing values generated)
(34 missing values generated)
.         bysort Code_Prov (Year): gen double cum_pmtb    = sum(pmtb)
.         bysort Code_Prov (Year): gen double cum_pma     = sum(PMA_1)
.         bysort Code_Prov (Year): gen double cum_pmdn    = sum(PMDN_1)
.         bysort Code_Prov (Year): gen double cum_pmapmdn = sum(pmapmdn)
.         foreach v in pmtb pma pmdn pmapmdn {
  2.                 gen double cum_ln_`v' = ln(cum_`v')
  3.                 label variable cum_ln_`v' "ln cumulative nominal `v' since $first_year
> "
  4.         }
.         foreach y of global Ylist {
  2.                 local yv y_`y'
  3.                 forvalues k = 1/3 {
  4.                         local inv ${inv`k'}
  5.                         x_for_outcome `y'
  6.                         local XkL `Xk' log_L
  7.                         local invS
  8.                         local invC
  9.                         foreach v of local inv {
 10.                                 local invS `invS' sm_`v'
 11.                                 local invC `invC' cum_`v'
 12.                         }
 13.                         local tag `y'_`k'
 14.                         global stored
 15.                         display as text _n "ROBUSTNESS `tag' (FGLS)  X = `Xk'"
 16.                         stash RA_`tag' : xtgls `yv' `inv' `Xk' if Year < $last_year, p
> anels(heteroskedastic) igls nolog
 17.                         hl_post RA `y' `k' `inv'
 18.                         stash RB_`tag' : xtgls `yv' `inv' `Xk' if !inlist(Code_Prov, 9
> 1, 94), panels(heteroskedastic) igls nolog
 19.                         hl_post RB `y' `k' `inv'
 20.                         stash RC_`tag' : xtgls `yv' `invS' `Xk' if Year > $first_year,
>  panels(heteroskedastic) igls nolog
 21.                         hl_post RC `y' `k' `invS'
 22.                         stash RD_`tag' : xtgls `yv' `invC' `Xk', panels(heteroskedasti
> c) igls nolog
 23.                         hl_post RD `y' `k' `invC'
 24.                         stash RT_`tag' : xtgls `yv' `inv' `XkL', panels(heteroskedasti
> c) igls nolog
 25.                         hl_post RT `y' `k' `inv'
 26.                         global storedR_`tag' $stored
 27.                 }
 28.                 if $have_esttab {
