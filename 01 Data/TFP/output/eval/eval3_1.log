.         ** leave-one-province-out: headline FGLS re-estimated 34 times, dropping one
.         ** province each time; a coefficient whose range straddles zero or whose sign dep
> ends
.         ** on one province is carried by that province (34 clusters is few)
.         local lrows
.         foreach y of global Ylist {
  2.                 forvalues k = 1/3 {
  3.                         foreach v in ${inv`k'} {
  4.                                 local lrows `lrows' `y'_`k'_`v'
  5.                         }
  6.                 }
  7.         }
.         local nl : word count `lrows'
.         matrix LOO = J(`nl', 6, .)
.         matrix rownames LOO = `lrows'
.         matrix colnames LOO = b_full b_min b_max prov_min prov_max n_signflip
.         local i = 0
.         foreach y of global Ylist {
  2.                 local yv y_`y'
  3.                 forvalues k = 1/3 {
  4.                         local inv ${inv`k'}
  5.                         x_for_outcome `y'
  6.                         local nv : word count `inv'
  7.                         local ng : word count `codes'
  8.                         matrix B = J(`ng', `nv', .)
  9.                         qui xtgls `yv' `inv' `Xk', panels(heteroskedastic) igls nolog
 10.                         local j = 0
 11.                         foreach v of local inv {
 12.                                 local ++j
 13.                                 local bfull`j' = _b[`v']
 14.                         }
 15.                         local c = 0
 16.                         foreach code of local codes {
 17.                                 local ++c
 18.                                 capture qui xtgls `yv' `inv' `Xk' if Code_Prov != `cod
> e', panels(heteroskedastic) igls nolog
 19.                                 if _rc continue
 20.                                 local j = 0
 21.                                 foreach v of local inv {
 22.                                         local ++j
 23.                                         matrix B[`c', `j'] = _b[`v']
 24.                                 }
 25.                         }
 26.                         local j = 0
 27.                         foreach v of local inv {
 28.                                 local ++j
 29.                                 local ++i
 30.                                 local bmin = .
 31.                                 local bmax = .
 32.                                 local cmin = .
 33.                                 local cmax = .
 34.                                 local nflip = 0
 35.                                 local c = 0
 36.                                 foreach code of local codes {
 37.                                         local ++c
 38.                                         local b = B[`c', `j']
 39.                                         if `b' < `bmin' {
 40.                                                 local bmin = `b'
 41.                                                 local cmin = `code'
 42.                                         }
 43.                                         if `bmax' == . | `b' > `bmax' {
 44.                                                 local bmax = `b'
 45.                                                 local cmax = `code'
 46.                                         }
 47.                                         if sign(`b') != sign(`bfull`j'') local ++nflip
 48.                                 }
 49.                                 matrix LOO[`i', 1] = `bfull`j''
 50.                                 matrix LOO[`i', 2] = `bmin'
 51.                                 matrix LOO[`i', 3] = `bmax'
 52.                                 matrix LOO[`i', 4] = `cmin'
 53.                                 matrix LOO[`i', 5] = `cmax'
 54.                                 matrix LOO[`i', 6] = `nflip'
 55.                         }
 56.                 }
 57.         }
