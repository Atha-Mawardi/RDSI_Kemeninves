. *** 9. Estimation loop ----------------------------------------------------------
. global dgcols p_Fui p_bplm p_haus2w p_mundlak p_overid p_year p_serial p_wald cd_pes1 p_c
> d1 ///
>         cd_pes2 p_cd2 p_fried2 dw_bh lbi_bw rho_ar1 p_eqPMA kpF_ss swF1 swF2 p_arF_ss p_e
> ndog_ss ///
>         kpF_ah p_hansen_ah p_endog_ah rho_ols rho_fe rho_sys rho_lsdvc j_sys p_ar1_sys p_
> ar2_sys ///
>         p_hansen_sys p_sargan_sys p_wild1 p_wild2 N N_g

. local ncol : word count $dgcols

. local rows

. foreach y of global Ylist {
  2.         forvalues k = 1/3 {
  3.                 local rows `rows' `y'_`k'
  4.         }
  5. }

. local nrow : word count `rows'

. matrix DIAG = J(`nrow', `ncol', .)

. matrix rownames DIAG = `rows'

. matrix colnames DIAG = $dgcols

. global hlfile "$root/eval3_1_headline.dta"

. capture postclose hl

. postfile hl str12 est str8 y byte k str14 var double(b se p) int N using "$hlfile", repla
> ce

. ** table files are appended to inside the loop: remove stale copies first
. foreach y of global Ylist {
  2.         capture erase "$tab - `y'.rtf"
  3. }

. capture erase "$tabcsv"

. capture erase "$tabxlsx"

. local lnTK log_L

. 
. foreach y of global Ylist {
  2.         local yv y_`y'
  3.         forvalues k = 1/3 {
  4.                 local inv ${inv`k'}
  5.                 local ss  ${ss`k'}
  6.                 x_for_outcome `y'
  7.                 display as text "X[`y']: `Xk'"
  8.                 local Xex `Xk'
  9.                 local xbar
 10.                 local invL
 11.                 local dinv
 12.                 local Linv23
 13.                 foreach v of local inv {
 14.                         local xbar `xbar' m_`v'
 15.                         local invL `invL' L.`v'
 16.                         local dinv `dinv' D.`v'
 17.                         local Linv23 `Linv23' L2.`v' L3.`v'
 18.                 }
 19.                 foreach v of local Xk {
 20.                         local xbar `xbar' m_`v'
 21.                 }
 22.                 local tag `y'_`k'
 23.                 global stored
 24.                 display as text _n "{hline 78}" _n "EQUATION `tag': `yv' = f(`inv', `X
> k')" _n "{hline 78}"
 25. 
.                 ** 9.1 pooled OLS with year dummies, cluster-robust
.                 stash POLS_`tag' : regress `yv' `inv' `Xk' $yrd, vce(cluster Code_Prov) $
> fmt
 26.                 hl_post POLS `y' `k' `inv'
 27.                 capture xtserial `yv' `inv' `Xk' $yrd
 28.                 if _rc == 0 dg_set `tag' p_serial `=r(p)'
 29. 
.                 ** 9.2 one-way FE: F test for u_i, groupwise heteroskedasticity, CD
.                 qui xtreg `yv' `inv' `Xk', fe
 30.                 dg_set `tag' p_Fui `=Ftail(e(df_a), e(df_r), e(F_f))'
 31.                 capture xttest3
 32.                 if _rc == 0 dg_set `tag' p_wald `=r(p)'
 33.                 capture xtcsd, pesaran abs
 34.                 if _rc == 0 {
 35.                         dg_set `tag' cd_pes1 `=r(pesaran)'
 36.                         dg_set `tag' p_cd1 `=2 * (1 - normal(abs(r(pesaran))))'
 37.                 }
 38.                 stash FE_`tag' : xtreg `yv' `inv' `Xk', fe vce(cluster Code_Prov) $fmt
 39.                 hl_post FE `y' `k' `inv'
 40. 
.                 ** 9.3 two-way FE (pembanding); FGLS = headline
.                 qui xtreg `yv' `inv' `Xk' $yrd, fe
 41.                 estimates store _fe2w_nr
 42.                 dg_set `tag' N `=e(N)'
 43.                 dg_set `tag' N_g `=e(N_g)'
 44.                 qui testparm $yrd
 45.                 dg_set `tag' p_year `=r(p)'
 46.                 capture xtcsd, pesaran abs
 47.                 if _rc == 0 {
 48.                         dg_set `tag' cd_pes2 `=r(pesaran)'
 49.                         dg_set `tag' p_cd2 `=2 * (1 - normal(abs(r(pesaran))))'
 50.                 }
 51.                 capture xtcsd, friedman
 52.                 if _rc == 0 dg_set `tag' p_fried2 `=chi2tail(e(g_max) - 1, r(fried))'
 53.                 stash FE2W_`tag' : xtreg `yv' `inv' `Xk' $yrd, fe vce(cluster Code_Pro
> v) $fmt
 54.                 hl_post FE2W `y' `k' `inv'
 55.                 if $stash_rc == 0 & $run_boot & $have_boottest {
 56.                         local j = 0
 57.                         foreach v of local inv {
 58.                                 local ++j
 59.                                 capture noisily boottest `v', reps($boot_reps) cluster
> (Code_Prov) seed(12345) nograph
 60.                                 if _rc == 0 dg_set `tag' p_wild`j' `=r(p)'
 61.                         }
 62.                 }
 63.                 stash FGLS_`tag' : xtgls `yv' `inv' `Xk', panels(heteroskedastic) igls
>  nolog
 64.                 hl_post FGLS `y' `k' `inv'
 65.                 if $stash_rc == 0 & `k' == 2 {
 66.                         test ln_pma = ln_pmdn
 67.                         dg_set `tag' p_eqPMA `=r(p)'
 68.                 }
 69. 
.                 ** 9.4 RE with year dummies; BP-LM, Hausman, robust Hausman (xtoverid)
.                 qui xtreg `yv' `inv' `Xk' $yrd, re
 70.                 estimates store _re2w_nr
 71.                 capture xttest0
 72.                 if _rc == 0 {
 73.                         local pbp = r(p)
 74.                         if missing(`pbp') local pbp = chi2tail(1, r(lm))
 75.                         dg_set `tag' p_bplm `pbp'
 76.                 }
 77.                 capture hausman _fe2w_nr _re2w_nr, sigmamore
 78.                 if _rc == 0 dg_set `tag' p_haus2w `=r(p)'
 79.                 stash RE2W_`tag' : xtreg `yv' `inv' `Xk' $yrd, re vce(cluster Code_Pro
> v) $fmt
 80.                 hl_post RE2W `y' `k' `inv'
 81.                 if $stash_rc == 0 & $have_xtoverid {
 82.                         capture xtoverid
 83.                         if _rc == 0 dg_set `tag' p_overid `=r(jp)'
 84.                 }
 85. 
.                 ** 9.5 Mundlak correlated random effects
.                 stash CRE_`tag' : xtreg `yv' `inv' `Xk' `xbar' $yrd, re vce(cluster Code_
> Prov) $fmt
 86.                 hl_post CRE `y' `k' `inv'
 87.                 if $stash_rc == 0 {
 88.                         capture test `xbar'
 89.                         if _rc == 0 dg_set `tag' p_mundlak `=r(p)'
 90.                 }
 91. 
.                 ** 9.6 Driscoll-Kraay SE (cross-sectional dependence), FE with year dummi
> es
.                 if $have_xtscc {
 92.                         stash DK_`tag' : xtscc `yv' `inv' `Xk' $yrd, fe lag(2)
 93.                         hl_post DK `y' `k' `inv'
 94.                 }
 95. 
.                 ** 9.7 FE with AR(1) disturbances
.                 stash FEAR1_`tag' : xtregar `yv' `inv' `Xk' $yrd_dyn, fe lbi $fmt
 96.                 if $stash_rc == 0 {
 97.                         dg_set `tag' dw_bh `=e(d1)'
 98.                         dg_set `tag' lbi_bw `=e(LBI)'
 99.                         dg_set `tag' rho_ar1 `=e(rho_ar)'
100.                         hl_post FEAR1 `y' `k' `inv'
101.                 }
102. 
.                 ** 9.8 investment lagged one year
.                 stash LAG_`tag' : xtreg `yv' `invL' `Xk' $yrd_dyn, fe vce(cluster Code_Pr
> ov) $fmt
103.                 hl_post LAG `y' `k' `invL'
104. 
.                 ** 9.9 IV: (a) FE2W with the shift-share instruments on the post-window s
> ample (just
.                 **     identified; KP rk F, Sanderson-Windmeijer F per regressor, Anderso
> n-Rubin p);
.                 **     (b) Anderson-Hsiao first-difference IV, D.investment instrumented 
> by the levels
.                 **     t-2 and t-3 (valid if investment is sequentially exogenous; Hansen
>  J tests the
.                 **     extra lag). Own lagged levels inside the within transformation are
>  NOT valid
.                 **     instruments (they are correlated with the province mean of the err
> or), which is
.                 **     why the FD form is used.
.                 if $run_iv & $have_xtivreg2 {
105.                         stash IVSS_`tag' : xtivreg2 `yv' (`inv' = `ss') `Xk' $yrd_dyn2
>  if Year >= $ss_start, fe cluster(Code_Prov) small ffirst endog(`inv')
106.                         if $stash_rc == 0 {
107.                                 dg_set `tag' kpF_ss `=e(widstat)'
108.                                 dg_set `tag' p_arF_ss `=e(arfp)'
109.                                 dg_set `tag' p_endog_ss `=e(estatp)'
110.                                 capture matrix F1 = e(first)
111.                                 if _rc == 0 {
112.                                         local j = 0
113.                                         foreach v of local inv {
114.                                                 local ++j
115.                                                 capture local sw = F1["SWF", "`v'"]
116.                                                 if _rc == 0 dg_set `tag' swF`j' `sw'
117.                                         }
118.                                 }
119.                                 hl_post IVSS `y' `k' `inv'
120.                         }
121.                         stash IVAH_`tag' : ivreg2 D.`yv' (`dinv' = `Linv23') D.(`Xk') 
> $yrd_dyn3, cluster(Code_Prov) small ffirst endog(`dinv')
122.                         if $stash_rc == 0 {
123.                                 dg_set `tag' kpF_ah `=e(widstat)'
124.                                 dg_set `tag' p_hansen_ah `=e(jp)'
125.                                 dg_set `tag' p_endog_ah `=e(estatp)'
126.                                 hl_post IVAH `y' `k' `dinv'
127.                         }
128.                 }
129. 
.                 ** 9.10 dynamic models: OLS / FE bounds, system GMM, bias-corrected LSDV
.                 if $run_dyn {
130.                         stash OLSLDV_`tag' : regress `yv' L.`yv' `inv' `Xk' $yrd_dyn, 
> vce(cluster Code_Prov) $fmt
131.                         if $stash_rc == 0 dg_set `tag' rho_ols `=_b[L.`yv']'
132.                         stash FELDV_`tag' : xtreg `yv' L.`yv' `inv' `Xk' $yrd_dyn, fe 
> vce(cluster Code_Prov) $fmt
133.                         if $stash_rc == 0 {
134.                                 dg_set `tag' rho_fe `=_b[L.`yv']'
135.                                 hl_post FELDV `y' `k' `inv'
136.                         }
137.                         ** system GMM: lagged outcome and investment endogenous; contr
> ols in Xk exogenous
.                         if $have_xtabond2 {
138.                                 stash SYS_`tag' : xtabond2 `yv' L.`yv' `inv' `Xk' $yrd
> _dyn, gmm(L.`yv', lag(1 2) collapse) gmm(`inv', lag(2 3) collapse) iv(`Xex') iv($yrd_dyn,
>  equation(level)) twostep robust small
139.                                 if $stash_rc == 0 {
140.                                         dg_set `tag' rho_sys `=_b[L.`yv']'
141.                                         dg_set `tag' j_sys `=e(j)'
142.                                         dg_set `tag' p_ar1_sys `=e(ar1p)'
143.                                         dg_set `tag' p_ar2_sys `=e(ar2p)'
144.                                         dg_set `tag' p_hansen_sys `=e(hansenp)'
145.                                         dg_set `tag' p_sargan_sys `=e(sarganp)'
146.                                         if e(j) >= e(N_g) display as error "warning: S
> YS_`tag' uses " e(j) " instruments for " e(N_g) " provinces"
147.                                         hl_post SYS `y' `k' `inv'
148.                                 }
149.                         }
150.                         ** LSDVC assumes strictly exogenous regressors: a dynamic coun
> terpart of FE2W
.                         ** (bounds on rho), not an endogeneity-robust estimator
.                         if $have_xtlsdvc {
151.                                 stash LSDVC_`tag' : xtlsdvc `yv' `inv' `Xk' $yrd_dyn, 
> initial(ab) bias(1) vcov($lsdvc_reps)
152.                                 if $stash_rc == 0 {
153.                                         dg_set `tag' rho_lsdvc `=_b[L.`yv']'
154.                                         hl_post LSDVC `y' `k' `inv'
155.                                 }
156.                         }
157.                 }
158.                 global stored_`tag' $stored
159.                 estimates drop _fe2w_nr _re2w_nr
160.                 local kp `inv' `invL' `dinv'
161.                 if $run_dyn local kp `kp' L.`yv'
162.                 capture noisily estimates table $stored, keep(`kp') b(%9.3f) se(%9.3f)
>  p(%5.3f) stats(N N_g) modelwidth(8) ///
>                         title("Equation `tag': investment coefficients across estimators"
> )
163.         }
164. 
.         ** tables for this outcome are written now and the estimates dropped: Stata holds
>  at
.         ** most 300 stored results and the full design has 18 x 15 models + robustness
.         if $have_esttab {
165.                 local f "$tab - `y'.rtf"
166.                 forvalues k = 1/3 {
167.                         local tag `y'_`k'
168.                         local inv ${inv`k'}
169.                         local invL
170.                         local dinv
171.                         foreach v of local inv {
172.                                 local invL `invL' L.`v'
173.                                 local dinv `dinv' D.`v'
174.                         }
175.                         if "${stored_`tag'}" != "" {
176.                                 capture noisily esttab ${stored_`tag'} using "`f'", ap
> pend b(%9.3f) se(%9.3f) star(* 0.10 ** 0.05 *** 0.01) ///
>                                         keep(`inv' `invL' `dinv' L.y_`y' $Xall, relax) or
> der(`inv' `invL' `dinv' L.y_`y') ///
>                                         indicate("Year dummies = yr2*") ///
>                                         stats(N N_g r2_w widstat estatp jp j hansenp ar2p
> , labels("N" "Provinces" "R2 within" "KP rk F" "endogeneity p" "Hansen J p (IV)" "Instrum
> ents" "Hansen p" "AR(2) p")) ///
>                                         mtitles nonotes title("${Ylabel_`y'}: spec `k' (`
> inv')") ///
>                                         addnotes("POLS/FE/FE2W/RE2W/CRE/LAG/FELDV: cluste
> r-robust SE by province; DK: Driscoll-Kraay; FEAR1: xtregar; IVSS: xtivreg2 fe, Bartik in
> struments, sample from $ss_start; IVAH: ivreg2 on first differences, instruments = levels
>  t-2, t-3; SYS: xtabond2 two-step robust small, collapsed, investment endogenous; LSDVC: 
> xtlsdvc initial(ab) bias(1), bootstrap SE" "b on ln investment = change in Y per log poin
> t (x 0.693 for a doubling, /100 for +1 percent); ln wage: elasticity" "* p<0.10 ** p<0.05
>  *** p<0.01")
177.                                 capture noisily esttab ${stored_`tag'} using "$tabcsv"
> , append b(%9.4f) se(%9.4f) star(* 0.10 ** 0.05 *** 0.01) ///
>                                         stats(N N_g r2_w widstat estatp jp j hansenp ar2p
> ) plain
178.                         }
179.                 }
180.         }
181.         forvalues k = 1/3 {
182.                 capture estimates drop ${stored_`y'_`k'}
183.         }
184. }
