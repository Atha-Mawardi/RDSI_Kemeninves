> "`f'", append b(%9.3f) se(%9.3f) star(* 0.10 ** 0.05 *** 0.01) ///
>                                                 keep(`inv' `invS' `invC' pilar_* deflator
>  log_L, relax) ///
>                                                 stats(N, labels("N")) mtitles nonotes ///
>                                                 title("${Ylabel_`y'}: spec `k' robustness
>  FGLS (RA drop last year, RB no Papua, RC two-year mean, RD cumulative, RT with log_L)")
 41.                                         capture noisily esttab ${storedR_`tag'} using 
> "$tabcsv", append b(%9.4f) se(%9.4f) star(* 0.10 ** 0.05 *** 0.01) ///
>                                                 stats(N) plain
 42.                                 }
