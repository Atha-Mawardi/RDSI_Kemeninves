. 
. *** 11. Multiple testing: Romano-Wolf step-down across the six outcomes ---------
. * Six outcomes per investment measure = six hypotheses tested at once; the Romano-Wolf
. * correction (Clarke, Romano & Wolf 2020, rwolf2) controls the family-wise error rate
. * with a cluster bootstrap. rwolf2 resamples clusters with bsample and re-runs the model
. * verbatim, so the models are run as OLS on the province-demeaned data (section 10)
. * rather than xtreg fe (a province drawn twice must not collapse into one panel), and
. * idcluster() gives each resampled province a fresh cluster id for the vce(). The wild
. * cluster bootstrap p-values per equation (boottest, section 9.3) are in the diagnostics.
. if $run_rw & $have_rwolf2 {
.         forvalues k = 1/3 {
  2.                 local inv ${inv`k'}
  3.                 local winv
  4.                 foreach v of local inv {
  5.                         local winv `winv' w_`v'
  6.                 }
  7.                 foreach v of local inv {
  8.                         local cmds
  9.                         local ivs
 10.                         foreach y of global Ylist {
 11.                                 x_for_outcome `y'
 12.                                 local Xy
 13.                                 foreach xv of local Xk {
 14.                                         local Xy `Xy' w_`xv'
 15.                                 }
 16.                                 local cmds `cmds' (regress w_y_`y' `winv' `Xy' $yrd, v
> ce(cluster Code_Prov))
 17.                                 local ivs `ivs' w_`v',
 18.                         }
 19.                         local ivs = substr("`ivs'", 1, length("`ivs'") - 1)
 20.                         display as text _n "Romano-Wolf step-down p-values, spec `k', 
> variable `v', six demeaned FE2W equations (reps = $rw_reps)"
 21.                         capture noisily rwolf2 `cmds', indepvars(`ivs') cluster(Code_P
> rov) idcluster(_cid) reps($rw_reps) seed(12345)
 22.                         if _rc == 0 {
 23.                                 capture noisily matlist e(RW), format(%8.4f)
 24.                         }
 25.                         else display as error "rwolf2 failed (rc = " _rc ") for spec `
> k' `v'"
 26.                         capture drop _cid
 27.                 }
 28.         }

