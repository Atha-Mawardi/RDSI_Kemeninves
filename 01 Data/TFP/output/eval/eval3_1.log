. 
. *** 10. Panel SUR across the six outcomes (per spec) ----------------------------
. * The six outcomes respond to the same shocks, so their errors are correlated. With the
. * SAME regressor list in every equation, Zellner's SUR coefficients equal equation-by-
. * equation OLS: sureg is kept only for the Breusch-Pagan test of residual independence.
. * The cross-equation tests (investment = 0 in all six equations; PMA = PMDN in all six)
. * therefore use suest with province clusters, which stacks the six FE2W equations and
. * gives a cluster-robust joint covariance. Province effects are removed by demeaning on
. * the common estimation sample; year dummies stay explicit. sureg/suest ignore the 34
. * absorbed province effects in their degrees of freedom (SE slightly understated).
. egen byte _ok = rowmiss(y_ipm y_tpt y_gini y_p0 y_lnwage y_padr $invall $Xall)

. qui replace _ok = (_ok == 0)

. foreach v in y_ipm y_tpt y_gini y_p0 y_lnwage y_padr $invall $Xall {
  2.         capture drop w_`v'
  3.         bysort Code_Prov: egen double _m = mean(`v') if _ok
  4.         gen double w_`v' = `v' - _m if _ok
  5.         drop _m
  6. }

. capture noisily putexcel set "$out", sheet("SUR") modify

. capture noisily putexcel A1 = "Panel SUR / suest on province-demeaned data with year dumm
> ies (common sample)"
file /Users/athamawardi/Desktop/Research-Projects/RDSI_Kemeninves/01 Data/TFP/output/eval/e
> val3_1_results.xlsx saved

. capture noisily putexcel A2 = "spec" B2 = "Breusch-Pagan chi2 (sureg)" C2 = "df" D2 = "p"
>  E2 = "suest: investment = 0 in all six equations, chi2" F2 = "df" G2 = "p" H2 = "suest: 
> PMA = PMDN in all six equations, p" I2 = "suest: PMA = PMDN jointly, chi2"
file /Users/athamawardi/Desktop/Research-Projects/RDSI_Kemeninves/01 Data/TFP/output/eval/e
> val3_1_results.xlsx saved

. local r = 3

. forvalues k = 1/3 {
  2.         local inv ${inv`k'}
  3.         local winv
  4.         foreach v of local inv {
  5.                 local winv `winv' w_`v'
  6.         }
  7.         display as text _n "{hline 78}" _n "PANEL SUR / SUEST, spec `k' (`inv')" _n "{
> hline 78}"
  8.         local eqs
  9.         local dlist
 10.         foreach y of global Ylist {
 11.                 x_for_outcome `y'
 12.                 local Xy
 13.                 foreach v of local Xk {
 14.                         local Xy `Xy' w_`v'
 15.                 }
 16.                 local eqs `eqs' (`y': w_y_`y' `winv' `Xy' $yrd)
 17.                 qui regress w_y_`y' `winv' `Xy' $yrd
 18.                 estimates store d_`y'
 19.                 local dlist `dlist' d_`y'
 20.         }
 21.         local bp = .
 22.         local dfbp = .
 23.         local pbp = .
 24.         capture noisily sureg `eqs', corr $fmt
 25.         if _rc == 0 {
 26.                 local bp = e(chi2_bp)
 27.                 local dfbp = e(df_bp)
 28.                 local pbp = chi2tail(`dfbp', `bp')
 29.                 display as text "Breusch-Pagan independence: chi2(`dfbp') = " as resul
> t %8.2f `bp' as text "  p = " as result %6.4f `pbp'
 30.         }
 31.         local cj = .
 32.         local dj = .
 33.         local pj = .
 34.         local peq = .
 35.         local ceq = .
 36.         local pF = .
 37.         capture noisily suest `dlist', vce(cluster Code_Prov)
 38.         if _rc == 0 {
 39.                 local tl
 40.                 foreach y of global Ylist {
 41.                         foreach v of local winv {
 42.                                 local tl `tl' [d_`y'_mean]`v'
 43.                         }
 44.                 }
 45.                 test `tl'
 46.                 local pj = r(p)
 47.                 local cj = r(chi2)
 48.                 local dj = r(df)
 49.                 * with 34 clusters the stacked covariance has rank at most 33: the chi
> 2 form over-rejects
.                 * for 6-12 restrictions; the F-form (chi2/q against F(q, 33)) is the cons
> ervative reading
.                 local pF = Ftail(`dj', 33, `cj' / `dj')
 50.                 display as text "suest joint test, investment = 0 in all six equations
> : chi2(`dj') = " as result %8.2f `cj' as text "  p = " as result %6.4f `pj' as text "  F-
> form p (F(`dj',33)) = " as result %6.4f `pF'
 51.                 if `k' == 2 {
 52.                         local tl
 53.                         foreach y of global Ylist {
 54.                                 local tl `tl' ([d_`y'_mean]w_ln_pma = [d_`y'_mean]w_ln
> _pmdn)
 55.                         }
 56.                         test `tl'
 57.                         local peq = r(p)
 58.                         local ceq = r(chi2)
 59.                         local pFeq = Ftail(r(df), 33, `ceq' / r(df))
 60.                         display as text "suest: PMA = PMDN in all six equations: chi2(
> " r(df) ") = " as result %8.2f `ceq' as text "  p = " as result %6.4f `peq' as text "  F-
> form p = " as result %6.4f `pFeq'
 61.                         foreach y of global Ylist {
 62.                                 qui test [d_`y'_mean]w_ln_pma = [d_`y'_mean]w_ln_pmdn
 63.                                 display as text "   `y': PMA = PMDN p = " as result %6
> .4f r(p)
 64.                         }
 65.                 }
 66.         }
 67.         capture noisily putexcel A`r' = `k' B`r' = `bp' C`r' = `dfbp' D`r' = `pbp' E`r
> ' = `cj' F`r' = `dj' G`r' = `pj' H`r' = `peq' I`r' = `ceq' J`r' = `pF'
 68.         if `r' == 3 capture noisily putexcel J2 = "F-form p of the joint test (chi2/q 
> vs F(q,33))"
 69.         local ++r
 70.         capture estimates drop `dlist'
 71. }

