> hline 78}"
 12.         local eqs
 13.         local dlist
 14.         foreach y of global Ylist {
 15.                 local Xy `wX'
 16.                 if inlist("`y'", "ipm", "gini", "p0", "lnwage") local Xy : list Xy - w
> _pilar_equity
 17.                 if "`y'" == "padr" local Xy : list Xy - w_pilar_institusi
 18.                 local eqs `eqs' (`y': w_y_`y' `winv' `Xy' $yrd)
 19.                 qui regress w_y_`y' `winv' `Xy' $yrd
 20.                 estimates store d_`y'
 21.                 local dlist `dlist' d_`y'
 22.         }
 23.         local bp = .
 24.         local dfbp = .
 25.         local pbp = .
 26.         capture noisily sureg `eqs', corr $fmt
 27.         if _rc == 0 {
 28.                 local bp = e(chi2_bp)
 29.                 local dfbp = e(df_bp)
 30.                 local pbp = chi2tail(`dfbp', `bp')
 31.                 display as text "Breusch-Pagan independence: chi2(`dfbp') = " as resul
> t %8.2f `bp' as text "  p = " as result %6.4f `pbp'
 32.         }
 33.         local cj = .
 34.         local dj = .
 35.         local pj = .
 36.         local peq = .
 37.         local ceq = .
 38.         local pF = .
 39.         capture noisily suest `dlist', vce(cluster Code_Prov)
 40.         if _rc == 0 {
 41.                 local tl
 42.                 foreach y of global Ylist {
 43.                         foreach v of local winv {
 44.                                 local tl `tl' [d_`y'_mean]`v'
 45.                         }
 46.                 }
 47.                 test `tl'
 48.                 local pj = r(p)
 49.                 local cj = r(chi2)
 50.                 local dj = r(df)
 51.                 * with 34 clusters the stacked covariance has rank at most 33: the chi
> 2 form over-rejects
.                 * for 6-12 restrictions; the F-form (chi2/q against F(q, 33)) is the cons
> ervative reading
.                 local pF = Ftail(`dj', 33, `cj' / `dj')
 52.                 display as text "suest joint test, investment = 0 in all six equations
> : chi2(`dj') = " as result %8.2f `cj' as text "  p = " as result %6.4f `pj' as text "  F-
> form p (F(`dj',33)) = " as result %6.4f `pF'
 53.                 if `k' == 2 {
 54.                         local tl
 55.                         foreach y of global Ylist {
 56.                                 local tl `tl' ([d_`y'_mean]w_ln_pma = [d_`y'_mean]w_ln
> _pmdn)
 57.                         }
 58.                         test `tl'
 59.                         local peq = r(p)
 60.                         local ceq = r(chi2)
 61.                         local pFeq = Ftail(r(df), 33, `ceq' / r(df))
 62.                         display as text "suest: PMA = PMDN in all six equations: chi2(
> " r(df) ") = " as result %8.2f `ceq' as text "  p = " as result %6.4f `peq' as text "  F-
> form p = " as result %6.4f `pFeq'
 63.                         foreach y of global Ylist {
 64.                                 qui test [d_`y'_mean]w_ln_pma = [d_`y'_mean]w_ln_pmdn
 65.                                 display as text "   `y': PMA = PMDN p = " as result %6
> .4f r(p)
 66.                         }
 67.                 }
 68.         }
 69.         capture noisily putexcel A`r' = `k' B`r' = `bp' C`r' = `dfbp' D`r' = `pbp' E`r
> ' = `cj' F`r' = `dj' G`r' = `pj' H`r' = `peq' I`r' = `ceq' J`r' = `pF'
 70.         if `r' == 3 capture noisily putexcel J2 = "F-form p of the joint test (chi2/q 
> vs F(q,33))"
 71.         local ++r
 72.         capture estimates drop `dlist'
 73. }

