. *** 8. Helper programs ----------------------------------------------------------
. ** stash NAME : command   -> runs the command, stores the estimates as NAME if it succeed
> s;
. **                           $stash_rc carries the command's return code
. capture program drop stash

. program define stash
  1.         gettoken name 0 : 0, parse(":")
  2.         gettoken colon 0 : 0, parse(":")
  3.         capture noisily `0'
  4.         global stash_rc = _rc
  5.         if _rc == 0 {
  6.                 capture estimates store `name'
  7.                 if _rc {
  8.                         global stash_rc = _rc
  9.                         display as error "`name': estimates store failed (rc = " _rc "
> )"
 10.                 }
 11.                 else global stored $stored `name'
 12.         }
 13.         else display as error "`name' failed (rc = " _rc "): command skipped"
 14. end

. ** hl_post EST Y K varlist -> appends the investment coefficients of the current e() to t
> he
. **                            headline file; does nothing when the preceding stash failed
. **                            (otherwise the previous model would be posted under a wrong
>  label)
. capture program drop hl_post

. program define hl_post
  1.         if "$stash_rc" != "0" exit
  2.         gettoken est 0 : 0
  3.         gettoken y 0 : 0
  4.         gettoken k 0 : 0
  5.         foreach v of local 0 {
  6.                 capture local b = _b[`v']
  7.                 if _rc | missing(`b') continue
  8.                 local se = _se[`v']
  9.                 local p = .
 10.                 if `se' > 0 & `se' < . {
 11.                         local t = `b' / `se'
 12.                         capture local df = e(df_r)
 13.                         if _rc == 0 & `df' < . local p = 2 * ttail(`df', abs(`t'))
 14.                         else local p = 2 * normal(-abs(`t'))
 15.                 }
 16.                 post hl ("`est'") ("`y'") (`k') ("`v'") (`b') (`se') (`p') (e(N))
 17.         }
 18. end

. ** dg_set ROW COL VALUE -> writes one cell of the diagnostics matrix
. capture program drop dg_set

. program define dg_set
  1.         args row col val
  2.         local r = rownumb(DIAG, "`row'")
  3.         local c = colnumb(DIAG, "`col'")
  4.         if "`val'" != "" & "`val'" != "." & `r' < . & `c' < . matrix DIAG[`r', `c'] = 
> `val'
  5. end

. 
. *** 9. Estimation loop ----------------------------------------------------------
. global dgcols p_Fui p_bplm p_haus2w p_mundlak p_overid p_year p_serial p_wald cd_pes1 p_c
> d1 ///
>         cd_pes2 p_cd2 p_fried2 dw_bh lbi_bw rho_ar1 p_eqPMA kpF_ss swF1 swF2 p_arF_ss p_e
> ndog_ss ///
>         kpF_ah p_hansen_ah p_endog_ah rho_ols rho_fe rho_sys rho_lsdvc j_sys p_ar1_sys p_
> ar2_sys ///
>         p_hansen_sys p_sargan_sys p_wild1 p_wild2 N N_g

. local ncol : word count $dgcols

. local rows

. foreach y of global Ylist {
  2.         forvalues k = 1/3 {
  3.                 local rows `rows' `y'_`k'
  4.         }
  5. }

. local nrow : word count `rows'

. matrix DIAG = J(`nrow', `ncol', .)

. matrix rownames DIAG = `rows'

. matrix colnames DIAG = $dgcols

. global hlfile "$root/eval3_headline.dta"

. capture postclose hl

. postfile hl str12 est str8 y byte k str14 var double(b se p) int N using "$hlfile", repla
> ce

. ** table files are appended to inside the loop: remove stale copies first
. foreach y of global Ylist {
  2.         capture erase "$tab - `y'.rtf"
  3. }

. capture erase "$tabcsv"

. capture erase "$tabxlsx"

. local lnTK log_L

. 
. foreach y of global Ylist {
  2.         local yv y_`y'
  3.         forvalues k = 1/3 {
  4.                 local inv ${inv`k'}
  5.                 local ss  ${ss`k'}
  6.                 local Xk $X
  7.                 if inlist("`y'", "ipm", "gini", "p0", "lnwage") local Xk : list Xk - p
> ilar_equity
  8.                 if "`y'" == "padr" local Xk : list Xk - pilar_institusi
  9.                 local Xex : list Xk - lnTK
 10.                 local xbar
 11.                 local invL
 12.                 local dinv
 13.                 local Linv23
 14.                 foreach v of local inv {
 15.                         local xbar `xbar' m_`v'
 16.                         local invL `invL' L.`v'
 17.                         local dinv `dinv' D.`v'
 18.                         local Linv23 `Linv23' L2.`v' L3.`v'
 19.                 }
 20.                 foreach v of local Xk {
 21.                         local xbar `xbar' m_`v'
 22.                 }
 23.                 local tag `y'_`k'
 24.                 global stored
 25.                 display as text _n "{hline 78}" _n "EQUATION `tag': `yv' = f(`inv', `X
> k')" _n "{hline 78}"
 26. 
.                 ** 9.1 pooled OLS with year dummies, cluster-robust
.                 stash POLS_`tag' : regress `yv' `inv' `Xk' $yrd, vce(cluster Code_Prov) $
> fmt
 27.                 hl_post POLS `y' `k' `inv'
 28.                 capture xtserial `yv' `inv' `Xk' $yrd
 29.                 if _rc == 0 dg_set `tag' p_serial `=r(p)'
 30. 
.                 ** 9.2 one-way FE: F test for u_i, groupwise heteroskedasticity, CD
.                 qui xtreg `yv' `inv' `Xk', fe
 31.                 dg_set `tag' p_Fui `=Ftail(e(df_a), e(df_r), e(F_f))'
 32.                 capture xttest3
 33.                 if _rc == 0 dg_set `tag' p_wald `=r(p)'
 34.                 capture xtcsd, pesaran abs
 35.                 if _rc == 0 {
 36.                         dg_set `tag' cd_pes1 `=r(pesaran)'
 37.                         dg_set `tag' p_cd1 `=2 * (1 - normal(abs(r(pesaran))))'
 38.                 }
 39.                 stash FE_`tag' : xtreg `yv' `inv' `Xk', fe vce(cluster Code_Prov) $fmt
 40.                 hl_post FE `y' `k' `inv'
 41. 
.                 ** 9.3 two-way FE (pembanding); FGLS = headline
.                 qui xtreg `yv' `inv' `Xk' $yrd, fe
 42.                 estimates store _fe2w_nr
 43.                 dg_set `tag' N `=e(N)'
 44.                 dg_set `tag' N_g `=e(N_g)'
 45.                 qui testparm $yrd
 46.                 dg_set `tag' p_year `=r(p)'
 47.                 capture xtcsd, pesaran abs
 48.                 if _rc == 0 {
 49.                         dg_set `tag' cd_pes2 `=r(pesaran)'
 50.                         dg_set `tag' p_cd2 `=2 * (1 - normal(abs(r(pesaran))))'
 51.                 }
 52.                 capture xtcsd, friedman
 53.                 if _rc == 0 dg_set `tag' p_fried2 `=chi2tail(e(g_max) - 1, r(fried))'
 54.                 stash FE2W_`tag' : xtreg `yv' `inv' `Xk' $yrd, fe vce(cluster Code_Pro
> v) $fmt
 55.                 hl_post FE2W `y' `k' `inv'
 56.                 if $stash_rc == 0 & $run_boot & $have_boottest {
 57.                         local j = 0
 58.                         foreach v of local inv {
 59.                                 local ++j
 60.                                 capture noisily boottest `v', reps($boot_reps) cluster
> (Code_Prov) seed(12345) nograph
 61.                                 if _rc == 0 dg_set `tag' p_wild`j' `=r(p)'
 62.                         }
 63.                 }
 64.                 stash FGLS_`tag' : xtgls `yv' `inv' `Xk', panels(heteroskedastic) igls
>  nolog
 65.                 hl_post FGLS `y' `k' `inv'
 66.                 if $stash_rc == 0 & `k' == 2 {
 67.                         test ln_pma = ln_pmdn
 68.                         dg_set `tag' p_eqPMA `=r(p)'
 69.                 }
 70. 
.                 ** 9.4 RE with year dummies; BP-LM, Hausman, robust Hausman (xtoverid)
.                 qui xtreg `yv' `inv' `Xk' $yrd, re
 71.                 estimates store _re2w_nr
 72.                 capture xttest0
 73.                 if _rc == 0 {
 74.                         local pbp = r(p)
 75.                         if missing(`pbp') local pbp = chi2tail(1, r(lm))
 76.                         dg_set `tag' p_bplm `pbp'
 77.                 }
 78.                 capture hausman _fe2w_nr _re2w_nr, sigmamore
 79.                 if _rc == 0 dg_set `tag' p_haus2w `=r(p)'
 80.                 stash RE2W_`tag' : xtreg `yv' `inv' `Xk' $yrd, re vce(cluster Code_Pro
> v) $fmt
 81.                 hl_post RE2W `y' `k' `inv'
 82.                 if $stash_rc == 0 & $have_xtoverid {
 83.                         capture xtoverid
 84.                         if _rc == 0 dg_set `tag' p_overid `=r(jp)'
 85.                 }
 86. 
.                 ** 9.5 Mundlak correlated random effects
.                 stash CRE_`tag' : xtreg `yv' `inv' `Xk' `xbar' $yrd, re vce(cluster Code_
> Prov) $fmt
 87.                 hl_post CRE `y' `k' `inv'
 88.                 if $stash_rc == 0 {
 89.                         capture test `xbar'
 90.                         if _rc == 0 dg_set `tag' p_mundlak `=r(p)'
 91.                 }
 92. 
.                 ** 9.6 Driscoll-Kraay SE (cross-sectional dependence), FE with year dummi
> es
.                 if $have_xtscc {
 93.                         stash DK_`tag' : xtscc `yv' `inv' `Xk' $yrd, fe lag(2)
 94.                         hl_post DK `y' `k' `inv'
 95.                 }
 96. 
.                 ** 9.7 FE with AR(1) disturbances
.                 stash FEAR1_`tag' : xtregar `yv' `inv' `Xk' $yrd_dyn, fe lbi $fmt
 97.                 if $stash_rc == 0 {
 98.                         dg_set `tag' dw_bh `=e(d1)'
 99.                         dg_set `tag' lbi_bw `=e(LBI)'
100.                         dg_set `tag' rho_ar1 `=e(rho_ar)'
101.                         hl_post FEAR1 `y' `k' `inv'
102.                 }
103. 
.                 ** 9.8 investment lagged one year
.                 stash LAG_`tag' : xtreg `yv' `invL' `Xk' $yrd_dyn, fe vce(cluster Code_Pr
> ov) $fmt
104.                 hl_post LAG `y' `k' `invL'
105. 
.                 ** 9.9 IV: (a) FE2W with the shift-share instruments on the post-window s
> ample (just
.                 **     identified; KP rk F, Sanderson-Windmeijer F per regressor, Anderso
> n-Rubin p);
.                 **     (b) Anderson-Hsiao first-difference IV, D.investment instrumented 
> by the levels
.                 **     t-2 and t-3 (valid if investment is sequentially exogenous; Hansen
>  J tests the
.                 **     extra lag). Own lagged levels inside the within transformation are
>  NOT valid
.                 **     instruments (they are correlated with the province mean of the err
> or), which is
.                 **     why the FD form is used.
.                 if $run_iv & $have_xtivreg2 {
106.                         stash IVSS_`tag' : xtivreg2 `yv' (`inv' = `ss') `Xk' $yrd_dyn2
>  if Year >= $ss_start, fe cluster(Code_Prov) small ffirst endog(`inv')
107.                         if $stash_rc == 0 {
108.                                 dg_set `tag' kpF_ss `=e(widstat)'
109.                                 dg_set `tag' p_arF_ss `=e(arfp)'
110.                                 dg_set `tag' p_endog_ss `=e(estatp)'
111.                                 capture matrix F1 = e(first)
112.                                 if _rc == 0 {
113.                                         local j = 0
114.                                         foreach v of local inv {
115.                                                 local ++j
116.                                                 capture local sw = F1["SWF", "`v'"]
117.                                                 if _rc == 0 dg_set `tag' swF`j' `sw'
118.                                         }
119.                                 }
120.                                 hl_post IVSS `y' `k' `inv'
121.                         }
122.                         stash IVAH_`tag' : ivreg2 D.`yv' (`dinv' = `Linv23') D.(`Xk') 
> $yrd_dyn3, cluster(Code_Prov) small ffirst endog(`dinv')
123.                         if $stash_rc == 0 {
124.                                 dg_set `tag' kpF_ah `=e(widstat)'
125.                                 dg_set `tag' p_hansen_ah `=e(jp)'
126.                                 dg_set `tag' p_endog_ah `=e(estatp)'
127.                                 hl_post IVAH `y' `k' `dinv'
128.                         }
129.                 }
130. 
.                 ** 9.10 dynamic models: OLS / FE bounds, system GMM, bias-corrected LSDV
.                 if $run_dyn {
131.                         stash OLSLDV_`tag' : regress `yv' L.`yv' `inv' `Xk' $yrd_dyn, 
> vce(cluster Code_Prov) $fmt
132.                         if $stash_rc == 0 dg_set `tag' rho_ols `=_b[L.`yv']'
133.                         stash FELDV_`tag' : xtreg `yv' L.`yv' `inv' `Xk' $yrd_dyn, fe 
> vce(cluster Code_Prov) $fmt
134.                         if $stash_rc == 0 {
135.                                 dg_set `tag' rho_fe `=_b[L.`yv']'
136.                                 hl_post FELDV `y' `k' `inv'
137.                         }
138.                         ** system GMM: lagged outcome and investment endogenous (GMM-s
> tyle lags t-2, t-3),
.                         ** log_L predetermined (t-1, t-2), other controls exogenous, year
>  dummies in the
.                         ** level equation; collapsed so that the instrument count stays b
> elow N = 34
.                         if $have_xtabond2 {
139.                                 stash SYS_`tag' : xtabond2 `yv' L.`yv' `inv' `Xk' $yrd
> _dyn, gmm(L.`yv', lag(1 2) collapse) gmm(`inv', lag(2 3) collapse) gmm(log_L, lag(1 2) co
> llapse) iv(`Xex') iv($yrd_dyn, equation(level)) twostep robust small
140.                                 if $stash_rc == 0 {
141.                                         dg_set `tag' rho_sys `=_b[L.`yv']'
142.                                         dg_set `tag' j_sys `=e(j)'
143.                                         dg_set `tag' p_ar1_sys `=e(ar1p)'
144.                                         dg_set `tag' p_ar2_sys `=e(ar2p)'
145.                                         dg_set `tag' p_hansen_sys `=e(hansenp)'
146.                                         dg_set `tag' p_sargan_sys `=e(sarganp)'
147.                                         if e(j) >= e(N_g) display as error "warning: S
> YS_`tag' uses " e(j) " instruments for " e(N_g) " provinces"
148.                                         hl_post SYS `y' `k' `inv'
149.                                 }
150.                         }
151.                         ** LSDVC assumes strictly exogenous regressors: a dynamic coun
> terpart of FE2W
.                         ** (bounds on rho), not an endogeneity-robust estimator
.                         if $have_xtlsdvc {
152.                                 stash LSDVC_`tag' : xtlsdvc `yv' `inv' `Xk' $yrd_dyn, 
> initial(ab) bias(1) vcov($lsdvc_reps)
153.                                 if $stash_rc == 0 {
154.                                         dg_set `tag' rho_lsdvc `=_b[L.`yv']'
155.                                         hl_post LSDVC `y' `k' `inv'
156.                                 }
157.                         }
158.                 }
159.                 global stored_`tag' $stored
160.                 estimates drop _fe2w_nr _re2w_nr
161.                 local kp `inv' `invL' `dinv'
162.                 if $run_dyn local kp `kp' L.`yv'
163.                 capture noisily estimates table $stored, keep(`kp') b(%9.3f) se(%9.3f)
>  p(%5.3f) stats(N N_g) modelwidth(8) ///
>                         title("Equation `tag': investment coefficients across estimators"
> )
164.         }
165. 
.         ** tables for this outcome are written now and the estimates dropped: Stata holds
>  at
.         ** most 300 stored results and the full design has 18 x 15 models + robustness
.         if $have_esttab {
166.                 local f "$tab - `y'.rtf"
167.                 forvalues k = 1/3 {
168.                         local tag `y'_`k'
169.                         local inv ${inv`k'}
170.                         local invL
171.                         local dinv
172.                         foreach v of local inv {
173.                                 local invL `invL' L.`v'
174.                                 local dinv `dinv' D.`v'
175.                         }
176.                         if "${stored_`tag'}" != "" {
177.                                 capture noisily esttab ${stored_`tag'} using "`f'", ap
> pend b(%9.3f) se(%9.3f) star(* 0.10 ** 0.05 *** 0.01) ///
>                                         keep(`inv' `invL' `dinv' L.y_`y' $X, relax) order
> (`inv' `invL' `dinv' L.y_`y') ///
>                                         indicate("Year dummies = yr2*") ///
>                                         stats(N N_g r2_w widstat estatp jp j hansenp ar2p
> , labels("N" "Provinces" "R2 within" "KP rk F" "endogeneity p" "Hansen J p (IV)" "Instrum
> ents" "Hansen p" "AR(2) p")) ///
>                                         mtitles nonotes title("${Ylabel_`y'}: spec `k' (`
> inv')") ///
>                                         addnotes("POLS/FE/FE2W/RE2W/CRE/LAG/FELDV: cluste
> r-robust SE by province; DK: Driscoll-Kraay; FEAR1: xtregar; IVSS: xtivreg2 fe, Bartik in
> struments, sample from $ss_start; IVAH: ivreg2 on first differences, instruments = levels
>  t-2, t-3; SYS: xtabond2 two-step robust small, collapsed, investment endogenous; LSDVC: 
> xtlsdvc initial(ab) bias(1), bootstrap SE" "b on ln investment = change in Y per log poin
> t (x 0.693 for a doubling, /100 for +1 percent); ln wage: elasticity" "* p<0.10 ** p<0.05
>  *** p<0.01")
178.                                 capture noisily esttab ${stored_`tag'} using "$tabcsv"
> , append b(%9.4f) se(%9.4f) star(* 0.10 ** 0.05 *** 0.01) ///
>                                         stats(N N_g r2_w widstat estatp jp j hansenp ar2p
> ) plain
179.                         }
180.                 }
181.         }
182.         forvalues k = 1/3 {
183.                 capture estimates drop ${stored_`y'_`k'}
184.         }
185. }

