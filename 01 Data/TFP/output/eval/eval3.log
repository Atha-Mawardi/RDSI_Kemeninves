.         ** leave-one-province-out: headline FGLS re-estimated 34 times, dropping one
.         ** province each time; a coefficient whose range straddles zero or whose sign dep
> ends
.         ** on one province is carried by that province (34 clusters is few)
.         local lrows
.         foreach y of global Ylist {
  2.                 forvalues k = 1/3 {
  3.                         foreach v in ${inv`k'} {
  4.                                 local lrows `lrows' `y'_`k'_`v'
  5.                         }
  6.                 }
  7.         }
.         local nl : word count `lrows'
.         matrix LOO = J(`nl', 6, .)
.         matrix rownames LOO = `lrows'
.         matrix colnames LOO = b_full b_min b_max prov_min prov_max n_signflip
.         local i = 0
.         foreach y of global Ylist {
  2.                 local yv y_`y'
  3.                 forvalues k = 1/3 {
  4.                         local inv ${inv`k'}
  5.                         local Xk $X
  6.                         if inlist("`y'", "ipm", "gini", "p0", "lnwage") local Xk : lis
> t Xk - pilar_equity
  7.                         if "`y'" == "padr" local Xk : list Xk - pilar_institusi
  8.                         local nv : word count `inv'
  9.                         local ng : word count `codes'
 10.                         matrix B = J(`ng', `nv', .)
 11.                         qui xtgls `yv' `inv' `Xk', panels(heteroskedastic) igls nolog
 12.                         local j = 0
 13.                         foreach v of local inv {
 14.                                 local ++j
 15.                                 local bfull`j' = _b[`v']
 16.                         }
 17.                         local c = 0
 18.                         foreach code of local codes {
 19.                                 local ++c
 20.                                 capture qui xtgls `yv' `inv' `Xk' if Code_Prov != `cod
> e', panels(heteroskedastic) igls nolog
 21.                                 if _rc continue
 22.                                 local j = 0
 23.                                 foreach v of local inv {
 24.                                         local ++j
 25.                                         matrix B[`c', `j'] = _b[`v']
 26.                                 }
 27.                         }
 28.                         local j = 0
 29.                         foreach v of local inv {
 30.                                 local ++j
 31.                                 local ++i
 32.                                 local bmin = .
 33.                                 local bmax = .
 34.                                 local cmin = .
 35.                                 local cmax = .
 36.                                 local nflip = 0
 37.                                 local c = 0
 38.                                 foreach code of local codes {
 39.                                         local ++c
 40.                                         local b = B[`c', `j']
 41.                                         if `b' < `bmin' {
 42.                                                 local bmin = `b'
 43.                                                 local cmin = `code'
 44.                                         }
 45.                                         if `bmax' == . | `b' > `bmax' {
 46.                                                 local bmax = `b'
 47.                                                 local cmax = `code'
 48.                                         }
 49.                                         if sign(`b') != sign(`bfull`j'') local ++nflip
 50.                                 }
 51.                                 matrix LOO[`i', 1] = `bfull`j''
 52.                                 matrix LOO[`i', 2] = `bmin'
 53.                                 matrix LOO[`i', 3] = `bmax'
 54.                                 matrix LOO[`i', 4] = `cmin'
 55.                                 matrix LOO[`i', 5] = `cmax'
 56.                                 matrix LOO[`i', 6] = `nflip'
 57.                         }
 58.                 }
 59.         }
.         display as text _n "LEAVE-ONE-PROVINCE-OUT (FGLS): full-sample b, min / max b ove
> r the 34 drops, province codes at the min / max, number of drops that flip the sign"

LEAVE-ONE-PROVINCE-OUT (FGLS): full-sample b, min / max b over the 34 drops, province codes
>  at the min / max, number of drops that flip the sign
.         matlist LOO, format(%9.3f)

