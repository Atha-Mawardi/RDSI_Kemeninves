. *** 12. Robustness (headline FGLS on every equation) ----------------------------
. * RA  drops the last wave
. * RB  without Papua and Papua Barat (parent-province series across the 2022 split)
. * RC  investment = two-year mean of ln investment (t, t-1): smooths lumpy realisations
. * RD  investment = ln cumulative nominal realisation since first_year
. * RQ  same six pillars (z rata penyusun, bukan PCA)
. * RT  without log_L
. if $run_robust {
.         foreach v in $invall {
  2.                 gen double sm_`v' = (`v' + L.`v') / 2
  3.                 label variable sm_`v' "two-year mean of `v'"
  4.         }
(34 missing values generated)
(34 missing values generated)
(34 missing values generated)
(34 missing values generated)
.         bysort Code_Prov (Year): gen double cum_pmtb    = sum(pmtb)
.         bysort Code_Prov (Year): gen double cum_pma     = sum(PMA_1)
.         bysort Code_Prov (Year): gen double cum_pmdn    = sum(PMDN_1)
.         bysort Code_Prov (Year): gen double cum_pmapmdn = sum(pmapmdn)
.         foreach v in pmtb pma pmdn pmapmdn {
  2.                 gen double cum_ln_`v' = ln(cum_`v')
  3.                 label variable cum_ln_`v' "ln cumulative nominal `v' since $first_year
> "
  4.         }
.         foreach y of global Ylist {
  2.                 local yv y_`y'
  3.                 forvalues k = 1/3 {
  4.                         local inv ${inv`k'}
  5.                         local Xk $X
  6.                         if inlist("`y'", "ipm", "gini", "p0", "lnwage") local Xk : lis
> t Xk - pilar_equity
  7.                         if "`y'" == "padr" local Xk : list Xk - pilar_institusi
  8.                         local XnoL : list Xk - lnTK
  9.                         local invS
 10.                         local invC
 11.                         foreach v of local inv {
 12.                                 local invS `invS' sm_`v'
 13.                                 local invC `invC' cum_`v'
 14.                         }
 15.                         local tag `y'_`k'
 16.                         global stored
 17.                         display as text _n "ROBUSTNESS `tag' (FGLS)"
 18.                         stash RA_`tag' : xtgls `yv' `inv' `Xk' if Year < $last_year, p
> anels(heteroskedastic) igls nolog
 19.                         hl_post RA `y' `k' `inv'
 20.                         stash RB_`tag' : xtgls `yv' `inv' `Xk' if !inlist(Code_Prov, 9
> 1, 94), panels(heteroskedastic) igls nolog
 21.                         hl_post RB `y' `k' `inv'
 22.                         stash RC_`tag' : xtgls `yv' `invS' `Xk' if Year > $first_year,
>  panels(heteroskedastic) igls nolog
 23.                         hl_post RC `y' `k' `invS'
 24.                         stash RD_`tag' : xtgls `yv' `invC' `Xk', panels(heteroskedasti
> c) igls nolog
 25.                         hl_post RD `y' `k' `invC'
 26.                         stash RQ_`tag' : xtgls `yv' `inv' `Xk', panels(heteroskedastic
> ) igls nolog
 27.                         hl_post RQ `y' `k' `inv'
 28.                         stash RT_`tag' : xtgls `yv' `inv' `XnoL', panels(heteroskedast
> ic) igls nolog
 29.                         hl_post RT `y' `k' `inv'
 30.                         global storedR_`tag' $stored
 31.                 }
 32.                 if $have_esttab {
 33.                         local f "$tab - `y'.rtf"
 34.                         forvalues k = 1/3 {
 35.                                 local tag `y'_`k'
 36.                                 local inv ${inv`k'}
 37.                                 local invS
 38.                                 local invC
 39.                                 foreach v of local inv {
 40.                                         local invS `invS' sm_`v'
 41.                                         local invC `invC' cum_`v'
 42.                                 }
 43.                                 if "${storedR_`tag'}" != "" {
 44.                                         capture noisily esttab ${storedR_`tag'} using 
> "`f'", append b(%9.3f) se(%9.3f) star(* 0.10 ** 0.05 *** 0.01) ///
>                                                 keep(`inv' `invS' `invC' pilar_* deflator
>  log_L, relax) ///
>                                                 stats(N, labels("N")) mtitles nonotes ///
>                                                 title("${Ylabel_`y'}: spec `k' robustness
>  FGLS (RA drop last year, RB no Papua, RC two-year mean, RD cumulative, RQ same pillars, 
> RT without log_L)")
 45.                                         capture noisily esttab ${storedR_`tag'} using 
> "$tabcsv", append b(%9.4f) se(%9.4f) star(* 0.10 ** 0.05 *** 0.01) ///
>                                                 stats(N) plain
 46.                                 }
 47.                         }
 48.                 }
 49.                 forvalues k = 1/3 {
 50.                         capture estimates drop ${storedR_`y'_`k'}
 51.                 }
 52.         }

