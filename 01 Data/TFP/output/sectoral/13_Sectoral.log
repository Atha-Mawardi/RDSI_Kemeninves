. * shift-share titik ujung. Identitas: dP = within + between + dinamik
. scalar dP = P_2024 - P_2017

. 
. program define _shift
  1.         args skema g label
  2.         scalar w = th_`g'_2017 * (p_`g'_2024 - p_`g'_2017)
  3.         scalar b = p_`g'_2017 * (th_`g'_2024 - th_`g'_2017)
  4.         scalar d = (th_`g'_2024 - th_`g'_2017) * (p_`g'_2024 - p_`g'_2017)
  5.         post S ("`skema'") ("`label'") ///
>                 (w) (b) (d) (w+b+d) ///
>                 (w/dP) (b/dP) (d/dP) ((w+b+d)/dP)
  6.         scalar wsum = wsum + w
  7.         scalar bsum = bsum + b
  8.         scalar dsum = dsum + d
  9. end

. 
