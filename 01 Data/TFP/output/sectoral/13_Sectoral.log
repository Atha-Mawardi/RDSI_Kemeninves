. * Olley-Pakes. Referensi = rerata tak tertimbang produktivitas kelompok.
. * Kovarian negatif: pekerja menumpuk di kelompok yang produktivitasnya di bawah rerata.
. foreach y in 2017 2024 {
  2.         scalar Pnow = P_`y'
  3.         scalar pbar3 = (p_primer_`y' + p_sekunder_`y' + p_tersier_`y') / 3
  4.         scalar cov3 = 0
  5.         foreach g in primer sekunder tersier {
  6.                 scalar covi = (th_`g'_`y' - 1/3) * (p_`g'_`y' - pbar3)
  7.                 scalar cov3 = cov3 + covi
  8.                 post O ("`y'") ("3 kelompok") ("`nama`g''") (pbar3) (covi) (covi/Pnow)
  9.         }
 10.         post O ("`y'") ("3 kelompok") ("Jumlah alokasi") (pbar3) (cov3) (cov3/Pnow)
 11. 
.         scalar pbar4 = (p_primer_`y' + p_sekunder_`y' + p_tva_`y' + p_tlain_`y') / 4
 12.         scalar cov4 = 0
 13.         foreach g in primer sekunder tva tlain {
 14.                 scalar covi = (th_`g'_`y' - 1/4) * (p_`g'_`y' - pbar4)
 15.                 scalar cov4 = cov4 + covi
 16.                 post O ("`y'") ("4 kelompok") ("`nama`g''") (pbar4) (covi) (covi/Pnow)
 17.         }
 18.         post O ("`y'") ("4 kelompok") ("Jumlah alokasi") (pbar4) (cov4) (cov4/Pnow)
 19. }

. 
. * kontrafaktual nasional 2024. 0,01 x selisih produk rata-rata.
. * K dan L agregat tetap => d log Y = d log TFP.
. program define _cf
  1.         args label src dst
  2.         scalar dPcf = 0.01 * (p_`dst'_2024 - p_`src'_2024)
  3.         scalar dlog = ln( (P_2024 + dPcf) / P_2024 )
  4.         post C ("`label'") (dlog) (100 * exp(dlog) - 100)
  5. end

. 
