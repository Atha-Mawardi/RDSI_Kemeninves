>         ln_upah_industri ///
>         ln_upah_listrik ///
>         ln_upah_air ///
>         ln_upah_konstruksi)

. 
. egen double ln_upah_tersier = rowmean( ///
>         ln_upah_perdagangan ///
>         ln_upah_transportasi ///
>         ln_upah_akomodasi ///
>         ln_upah_informasi ///
>         ln_upah_keuangan ///
