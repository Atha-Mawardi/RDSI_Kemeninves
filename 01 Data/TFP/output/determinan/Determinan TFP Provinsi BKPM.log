. capture program drop build_index

. program define build_index
  1.         * syntax: build_index name, vars(varlist) anchor(varname) title(string)
.         syntax name(name=idx), vars(varlist) anchor(varname) [title(string)]
  2.         display as text _n "{hline 78}" _n "PCA pillar: `idx'  (`title')" _n "inputs: `vars'" _n "{hline 78}"
  3.         * 5a. standardised inputs z_*
.         local zvars
  4.         foreach v of varlist `vars' {
  5.                 capture drop z_`v'
  6.                 if "$pca_mode" == "byyear" {
  7.                         tempvar m s
  8.                         bysort Year: egen double `m' = mean(`v')
  9.                         bysort Year: egen double `s' = sd(`v')
 10.                         gen double z_`v' = (`v' - `m') / `s'
 11.                 }
 12.                 else {
 13.                         egen double z_`v' = std(`v')
 14.                 }
 15.                 local zvars `zvars' z_`v'
 16.         }
 17.         local p : word count `zvars'
 18.         * 5b. Bartlett test of sphericity: H0 correlation matrix = identity
.         qui correlate `zvars'
 19.         matrix R = r(C)
 20.         local n = r(N)
 21.         local chi2 = -(`n' - 1 - (2*`p' + 5)/6) * ln(det(R))
 22.         local df   = `p'*(`p' - 1)/2
 23.         local pb   = chi2tail(`df', `chi2')
 24.         display as text "Bartlett sphericity: chi2(`df') = " as result %9.2f `chi2' as text "  p = " as result %6.4f `pb'
 25.         if `pb' > 0.05 display as error "warning: Bartlett does not reject sphericity for `idx': the inputs are nearly " ///
>                 "uncorrelated, so PC1 is not a meaningful common factor (check the inputs / proxy)"
 26.         * 5c. Cronbach alpha (standardised items)
.         qui alpha `zvars', std
 27.         local calpha = r(alpha)
 28.         display as text "Cronbach alpha (std items): " as result %6.3f `calpha'
 29.         if `calpha' < 0.5 display as error "warning: Cronbach alpha below 0.5 for `idx' (inputs share little common variance)"
 30.         * 5d. PCA (correlation matrix), keep the first component
.         pca `zvars', components(1)
 31.         estat kmo
 32.         local kmo = r(kmo)
 33.         matrix EV = e(Ev)
 34.         matrix L  = e(L)
 35.         local ev1 = EV[1,1]
 36.         local prop1 = `ev1' / `p'
 37.         local nkaiser = 0
 38.         forvalues j = 1/`p' {
 39.                 if EV[1,`j'] > 1 local ++nkaiser
 40.         }
 41.         display as text "eigenvalue PC1 = " as result %6.3f `ev1' as text "  share explained = " as result %5.1f 100*`prop1' "%" 
> ///
>                 as text "  components with eigenvalue > 1 = " as result `nkaiser' as text "  KMO = " as result %5.3f `kmo'
 42.         if `prop1' < 0.5 display as error "warning: PC1 explains less than half of the variance of `idx'"
 43.         if `kmo' < 0.5  display as error "warning: KMO below 0.5 for `idx' (sampling adequacy is poor)"
 44.         capture noisily {
 45.                 screeplot, name(scree_`idx', replace) title("Scree plot: `idx'")
 46.                 graph export "$outdir/Determinan TFP - scree `idx'.png", replace width(1200)
 47.         }
 48.         * 5e. scores, sign orientation by the anchor loading
.         capture drop sc_`idx'
 49.         predict double sc_`idx', score
 50.         local r = rownumb(L, "z_`anchor'")
 51.         local sgn = 1
 52.         if L[`r',1] < 0 {
 53.                 local sgn = -1
 54.                 qui replace sc_`idx' = -sc_`idx'
 55.                 display as text "PC1 sign flipped so that `anchor' loads positively"
 56.         }
 57.         matrix L1 = L[1..`p', 1] * `sgn'
 58.         matrix colnames L1 = PC1_loading
 59.         display as text "oriented PC1 loadings (`idx'):"
 60.         matlist L1, format(%8.3f)
 61.         * polarity check: every input was coded so that 'higher = better'; a negative
.         * oriented loading means PC1 mixes good and bad directions of that input
.         local nneg = 0
 62.         forvalues j = 1/`p' {
 63.                 if L1[`j',1] < 0 local ++nneg
 64.         }
 65.         global pca_`idx'_nneg = `nneg'
 66.         if `nneg' > 0 display as error "warning: `nneg' input(s) of `idx' load with the opposite sign on PC1 " ///
>                 "(mixed polarity); compare with the additive index idx_`idx'_eq"
 67.         * 5f. index versions: PC1 z-score, PC1 0-100, and an equal-weight additive
.         *     z-score index (OECD/JRC fallback when PCA polarity is inconsistent)
.         capture drop idx_`idx' idx_`idx'_100 idx_`idx'_eq
 68.         egen double idx_`idx' = std(sc_`idx')
 69.         qui summarize sc_`idx'
 70.         gen double idx_`idx'_100 = 100 * (sc_`idx' - r(min)) / (r(max) - r(min))
 71.         tempvar zsum
 72.         egen double `zsum' = rowmean(`zvars')
 73.         egen double idx_`idx'_eq = std(`zsum')
 74.         label variable sc_`idx'      "PC1 score `idx' (raw, oriented)"
 75.         label variable idx_`idx'     "Index `idx' (PC1, mean 0 sd 1)"
 76.         label variable idx_`idx'_100 "Index `idx' (PC1, 0-100)"
 77.         label variable idx_`idx'_eq  "Index `idx' (equal-weight mean of z inputs, mean 0 sd 1)"
 78.         * 5g. write the PCA summary to the results workbook
.         * no 'replace' on the sheet: with sheet(..., replace) the first putexcel write after
.         * 'set' is discarded in Stata 17; the workbook is recreated at the start of section 5
.         putexcel set "$out", sheet("PCA_`idx'") modify
 79.         putexcel A1 = "Pillar `idx': `title'"
 80.         putexcel A2 = "inputs" B2 = "`vars'"
 81.         putexcel A3 = "pca_mode" B3 = "$pca_mode"
 82.         putexcel A4 = "N" B4 = `n'
 83.         putexcel A5 = "Bartlett chi2" B5 = `chi2' C5 = "df" D5 = `df' E5 = "p" F5 = `pb'
 84.         putexcel A6 = "KMO" B6 = `kmo'
 85.         putexcel A7 = "Cronbach alpha" B7 = `calpha'
 86.         putexcel A8 = "eigenvalue PC1" B8 = `ev1' C8 = "share" D8 = `prop1' E8 = "n eigen>1" F8 = `nkaiser'
 87.         putexcel A10 = "Eigenvalues"
 88.         putexcel A11 = matrix(EV), names
 89.         putexcel A14 = "Oriented PC1 loadings"
 90.         putexcel A15 = matrix(L1), names
 91.         * keep the statistics for the diagnostics sheet
.         global pca_`idx'_ev1 = `ev1'
 92.         global pca_`idx'_prop = `prop1'
 93.         global pca_`idx'_kmo = `kmo'
 94.         global pca_`idx'_bart_p = `pb'
 95.         global pca_`idx'_alpha = `calpha'
 96. end

. 
