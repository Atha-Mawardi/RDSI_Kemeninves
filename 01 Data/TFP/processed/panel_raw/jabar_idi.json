  <style>
    /* CSS variables supporting dynamic theme colors */
    :root {
      transition: background-color 0.5s ease, color 0.5s ease;
    }

    /* Light Mode Style Tokens */
    :root.light-mode {
      --bg-dark: #f1f5f9;
      --bg-gradient-start: #f8fafc;
      --bg-gradient-end: #cbd5e1;
      --bg-card: rgba(255, 255, 255, 0.88);
      --card-border: rgba(15, 23, 42, 0.12);
      --card-shadow-rgb: 15, 23, 42;
      --text-main: #0f172a;
      --text-muted: #334155;
      --text-dim: #64748b;
      --meta-bg: rgba(15, 23, 42, 0.04);
      --meta-border: rgba(15, 23, 42, 0.05);

      /* Dynamic accent defaults */
      --theme-color: #ef4444;
      --theme-glow: rgba(239, 68, 68, 0.08);
      --theme-text: #dc2626;
      --theme-bg-soft: rgba(239, 68, 68, 0.05);
    }

    /* Dark Mode Style Tokens (Rich Slate/Navy) */
    :root.dark-mode {
      --bg-dark: #0f172a;
      --bg-gradient-start: #1e293b;
      --bg-gradient-end: #090d16;
      --bg-card: rgba(30, 41, 59, 0.75);
      --card-border: rgba(255, 255, 255, 0.18);
      --card-shadow-rgb: 0, 0, 0;
      --text-main: #f8fafc;
      --text-muted: #cbd5e1;
      --text-dim: #64748b;
      --meta-bg: rgba(255, 255, 255, 0.04);
      --meta-border: rgba(255, 255, 255, 0.04);

      /* Dynamic accent defaults */
      --theme-color: #f87171;
      --theme-glow: rgba(248, 113, 113, 0.18);
      --theme-text: #fca5a5;
      --theme-bg-soft: rgba(248, 113, 113, 0.08);
    }

    /* Success Theme overrides */
    :root.light-mode.theme-success {
      --theme-color: #10b981;
      --theme-glow: rgba(16, 185, 129, 0.08);
      --theme-text: #059669;
      --theme-bg-soft: rgba(16, 185, 129, 0.05);
    }

    :root.dark-mode.theme-success {
      --theme-color: #34d399;
      --theme-glow: rgba(52, 211, 153, 0.18);
      --theme-text: #6ee7b7;
      --theme-bg-soft: rgba(52, 211, 153, 0.08);
    }

    /* Redirect Theme overrides */
    :root.light-mode.theme-redirect {
      --theme-color: #3b82f6;
      --theme-glow: rgba(59, 130, 246, 0.08);
      --theme-text: #2563eb;
      --theme-bg-soft: rgba(59, 130, 246, 0.05);
    }

    :root.dark-mode.theme-redirect {
      --theme-color: #60a5fa;
      --theme-glow: rgba(96, 165, 250, 0.18);
      --theme-text: #93c5fd;
      --theme-bg-soft: rgba(96, 165, 250, 0.08);
    }

    /* Client Error Theme overrides */
    :root.light-mode.theme-client {
      --theme-color: #f59e0b;
      --theme-glow: rgba(245, 158, 11, 0.08);
      --theme-text: #b45309;
      --theme-bg-soft: rgba(245, 158, 11, 0.05);
    }

    :root.dark-mode.theme-client {
      --theme-color: #fbbf24;
      --theme-glow: rgba(251, 191, 36, 0.18);
      --theme-text: #fcd34d;
      --theme-bg-soft: rgba(251, 191, 36, 0.08);
    }

    /* Server Error Theme overrides */
    :root.light-mode.theme-server {
      --theme-color: #ef4444;
      --theme-glow: rgba(239, 68, 68, 0.08);
      --theme-text: #dc2626;
      --theme-bg-soft: rgba(239, 68, 68, 0.05);
    }

    :root.dark-mode.theme-server {
      --theme-color: #f87171;
      --theme-glow: rgba(248, 113, 113, 0.18);
      --theme-text: #fca5a5;
      --theme-bg-soft: rgba(248, 113, 113, 0.08);
    }

    /* Security Theme overrides */
    :root.light-mode.theme-security {
      --theme-color: #9333ea;
      --theme-glow: rgba(147, 51, 234, 0.08);
      --theme-text: #7e22ce;
      --theme-bg-soft: rgba(147, 51, 234, 0.05);
    }

    :root.dark-mode.theme-security {
      --theme-color: #c084fc;
      --theme-glow: rgba(192, 132, 252, 0.18);
      --theme-text: #d8b4fe;
      --theme-bg-soft: rgba(192, 132, 252, 0.08);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Outfit', sans-serif;
      background-color: var(--bg-dark);
      background-image: radial-gradient(circle at center, var(--bg-gradient-start), var(--bg-gradient-end));
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 40px 24px;
      overflow-x: hidden;
      position: relative;
    }

    /* Page Header */
    .page-header {
      width: 100%;
      max-width: 720px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      z-index: 10;
    }

    .header-logo {
      font-size: 0.85rem;
      font-weight: 800;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--text-dim);
    }

    .theme-toggle-btn {
      background: var(--bg-card);
      border: 1px solid var(--card-border);
      color: var(--text-main);
      width: 36px;
      height: 36px;
      border-radius: 10px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 12px rgba(var(--card-shadow-rgb), 0.15);
      transition: all 0.3s ease;
      z-index: 15;
    }

    .theme-toggle-btn:hover {
      transform: translateY(-2px);
      border-color: var(--theme-color);
      box-shadow: 0 4px 12px var(--theme-glow);
    }

    .theme-toggle-btn svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    /* Ambient Background Glows */
    .glow-container {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      z-index: 0;
      pointer-events: none;
    }

    .glow-blob {
      position: absolute;
      width: 45vw;
      height: 45vw;
      max-width: 600px;
      max-height: 600px;
      border-radius: 50%;
      background: var(--theme-glow);
      filter: blur(120px);
      opacity: 0.6;
      transition: background 0.8s ease, transform 15s infinite alternate ease-in-out;
    }

    .glow-1 {
      top: -10%;
      left: -10%;
      animation: drift-1 20s infinite alternate ease-in-out;
    }

    .glow-2 {
      bottom: -10%;
      right: -10%;
      animation: drift-2 20s infinite alternate ease-in-out;
    }

    @keyframes drift-1 {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(100px, 80px) scale(1.1); }
    }

    @keyframes drift-2 {
      0% { transform: translate(0, 0) scale(1.1); }
      100% { transform: translate(-80px, -100px) scale(0.9); }
    }

    /* Main Container */
    main {
      width: 100%;
      max-width: 720px;
      z-index: 10;
      display: flex;
      flex-direction: column;
      gap: 24px;
      perspective: 1000px;
    }

    /* Card Wrapper (for 3D tilt effect) */
    .ticket-wrapper {
      width: 100%;
      transition: transform 0.1s ease-out;
      transform-style: preserve-3d;
    }

    /* Ticket Card Structure - Border, Shadow and Cutouts are now handled by Inline SVG */
    .ticket-card {
      position: relative;
      display: flex;
      flex-direction: row;
      overflow: visible;
      border: none;
      background: none;
      filter: drop-shadow(0 15px 35px rgba(var(--card-shadow-rgb), 0.22)) drop-shadow(0 0 20px var(--theme-glow));
      transition: filter 0.8s ease;
      transform: translateZ(20px);
    }

    /* SVG Background Layer */
    .ticket-svg-bg {
      position: absolute;
      top: -1px;
      left: -1px;
      width: calc(100% + 2px);
      height: calc(100% + 2px);
      z-index: 1;
      pointer-events: none;
      filter: drop-shadow(0px 1px 0px rgba(255, 255, 255, 0.05));
    }

    .ticket-svg-bg path {
      transition: fill 0.5s ease, stroke 0.5s ease;
    }

    .ticket-svg-bg line {
      transition: stroke 0.5s ease;
    }

    /* Ticket Content Container */
    .ticket-content-container {
      position: relative;
      z-index: 2;
      width: 100%;
      display: flex;
      flex-direction: row;
      border-radius: 18px;
      overflow: hidden;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    /* Left Section (Tear-off Ticket) */
    .ticket-left {
      width: 200px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: center;
      padding: 40px 24px;
      flex-shrink: 0;
    }

    .error-code-badge {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      width: 100%;
    }

    .error-code-num {
      font-size: 3.8rem;
      font-weight: 800;
      line-height: 1;
      color: var(--text-main);
      letter-spacing: -0.05em;
      transition: color 0.3s ease;
    }

    .error-code-label {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      color: var(--theme-text);
      text-transform: uppercase;
      transition: color 0.8s ease, background-color 0.8s ease;
      background: var(--theme-bg-soft);
      padding: 4px 8px;
      border-radius: 4px;
      margin-top: 8px;
      text-align: center;
    }

    /* Left Side Meta Info List */
    .left-meta-container {
      display: flex;
      flex-direction: column;
      gap: 14px;
      width: 100%;
      margin-top: 24px;
      padding-top: 24px;
      border-top: 1px dashed rgba(255, 255, 255, 0.1);
    }

    :root.light-mode .left-meta-container {
      border-top: 1px dashed rgba(15, 23, 42, 0.1);
    }

    .left-meta-item {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .left-meta-label {
      font-size: 0.58rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: var(--text-dim);
      text-transform: uppercase;
    }

    .left-meta-value {
      font-size: 0.72rem;
      font-family: 'JetBrains Mono', monospace;
      color: var(--text-main);
      word-break: break-all;
      line-height: 1.35;
    }

    /* Right Section (Main Content) */
    .ticket-right {
      flex: 1;
      padding: 40px 44px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 24px;
    }

    .ticket-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .system-label {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      color: var(--text-dim);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Live status pulsing dot */
    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: var(--theme-color);
      box-shadow: 0 0 10px var(--theme-color);
      animation: pulse 1.8s infinite;
      transition: background-color 0.8s ease, box-shadow 0.8s ease;
    }

    @keyframes pulse {
      0% { transform: scale(0.9); opacity: 0.6; }
      50% { transform: scale(1.2); opacity: 1; box-shadow: 0 0 14px var(--theme-color); }
      100% { transform: scale(0.9); opacity: 0.6; }
    }

    .timestamp-label {
      font-size: 0.7rem;
      font-family: 'JetBrains Mono', monospace;
      color: var(--text-dim);
      text-align: right;
    }

    .ticket-body {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .error-title {
      font-size: 1.6rem;
      font-weight: 700;
      line-height: 1.3;
      color: var(--text-main);
      letter-spacing: -0.01em;
    }

    .error-desc {
      font-size: 0.92rem;
      line-height: 1.6;
      color: var(--text-muted);
      font-weight: 400;
    }

    /* Boarding Pass Style Meta Info */
    .ticket-meta-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px 20px;
      margin-top: 10px;
      padding-top: 18px;
      border-top: 1px dashed rgba(255, 255, 255, 0.1);
    }

    :root.light-mode .ticket-meta-grid {
      border-top: 1px dashed rgba(15, 23, 42, 0.1);
    }

    .meta-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .meta-item.full-width {
      grid-column: span 3;
    }

    .meta-label {
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--text-dim);
      text-transform: uppercase;
    }

    .meta-value {
      font-size: 0.8rem;
      font-family: 'JetBrains Mono', monospace;
      color: var(--text-main);
      word-break: break-all;
      font-weight: 500;
    }

    /* Full-width callout for URL Path */
    .meta-item.full-width .meta-value {
      font-size: 0.75rem;
      color: var(--theme-text);
      background: var(--theme-bg-soft);
      border-left: 3px solid var(--theme-color);
      padding: 8px 12px;
      border-radius: 6px;
      word-break: break-all;
      transition: color 0.5s ease, background-color 0.5s ease, border-color 0.5s ease;
    }

    .ticket-footer {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-top: 12px;
      gap: 20px;
    }

    .diagnostic-teaser {
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
    }

    .teaser-label {
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      color: var(--text-dim);
      text-transform: uppercase;
    }

    .teaser-value {
      font-size: 0.72rem;
      font-family: 'JetBrains Mono', monospace;
      color: var(--text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 250px;
    }

    /* Report Button Group & CTA */
    .report-action-group {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 6px;
    }

    .btn-report-cta {
      font-size: 0.65rem;
      font-weight: 700;
      color: var(--theme-text);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      animation: bounce-small 2s infinite ease-in-out;
      transition: color 0.5s ease;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }

    @keyframes bounce-small {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-3px); }
    }

    /* WhatsApp Action Button */
    .btn-report {
      background: var(--theme-color);
      color: #ffffff;
      border: none;
      padding: 12px 24px;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      box-shadow: 0 4px 12px var(--theme-glow);
      transition: background-color 0.8s ease, transform 0.2s ease, box-shadow 0.3s ease;
      white-space: nowrap;
    }

    .btn-report:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px var(--theme-color);
      filter: brightness(1.1);
    }

    .btn-report:active {
      transform: translateY(0);
    }

    .btn-report svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
    }

    /* Info Note Box */
    .info-note {
      background: var(--bg-card);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 18px 24px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.05);
      transition: background-color 0.5s ease, border-color 0.5s ease;
    }

    .info-note-title {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: var(--text-main);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .info-note-title svg {
      width: 14px;
      height: 14px;
      fill: var(--theme-text);
      transition: fill 0.8s ease;
    }

    .info-note-desc {
      font-size: 0.82rem;
      line-height: 1.5;
      color: var(--text-muted);
    }

    /* Mobile Adaptations */
    @media (max-width: 600px) {
      body {
        padding: 20px 12px;
        justify-content: flex-start; /* Ensures natural scroll and prevents header overlap */
      }

      .page-header {
        margin-bottom: 8px;
      }

      .ticket-card {
        flex-direction: column;
      }

      .ticket-content-container {
        flex-direction: column;
      }

      .ticket-left {
        width: 100%;
        height: auto;
        padding: 16px 14px;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .error-code-badge {
        align-items: center;
        flex-shrink: 0;
        width: 25%;
        text-align: center;
      }

      .error-code-num {
        font-size: 1.8rem; /* Small ticket stamp style, prioritize visitor details */
        font-weight: 800;
        letter-spacing: -0.02em;
        text-align: center;
      }

      .error-code-label {
        font-size: 0.5rem;
        padding: 2px 4px;
        margin-top: 2px;
        letter-spacing: 0.05em;
        text-align: center;
        display: inline-block;
      }

      .left-meta-container {
        margin-top: 0;
        padding-top: 0;
        border-top: none;
        width: auto;
        flex: 1;
        display: flex;
        flex-direction: column; /* Stacked vertically to prevent character truncation/wrap */
        gap: 5px;
        max-width: 75%; /* Prioritize visitor metadata space */
      }

      .left-meta-item:nth-child(3) {
        grid-column: auto;
      }

      .left-meta-label {
        font-size: 0.52rem;
      }

      .left-meta-value {
        font-size: 0.68rem;
        line-height: 1.2;
      }

      .ticket-right {
        padding: 24px 20px; /* Reduced from 40px 44px */
        gap: 16px; /* Reduced from 24px */
      }

      .ticket-header {
        flex-wrap: wrap;
        gap: 6px;
      }

      .timestamp-label {
        width: 100%;
        text-align: left;
        font-size: 0.65rem;
      }

      .error-title {
        font-size: 1.15rem; /* Reduced from 1.6rem */
        line-height: 1.3;
      }

      .error-desc {
        font-size: 0.8rem; /* Reduced from 0.92rem */
        line-height: 1.45;
      }

      .meta-item.full-width {
        width: 100%;
        margin-top: 6px !important;
      }

      .meta-item.full-width .meta-value {
        font-size: 0.68rem;
        padding: 6px 10px;
      }

      .ticket-footer {
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
      }

      .diagnostic-teaser {
        max-width: 100%;
      }

      .teaser-value {
        max-width: 100%;
      }

      .report-action-group {
        width: 100%;
        align-items: center;
        gap: 6px;
      }

      .btn-report-cta {
        font-size: 0.62rem;
        text-align: center;
      }

      .btn-report {
        justify-content: center;
        width: 100%;
        padding: 10px; /* Reduced padding from 12px */
        font-size: 0.78rem;
      }

      /* Compact Info Note for Mobile */
      .info-note {
        padding: 12px 16px;
        gap: 4px;
      }

      .info-note-title {
        font-size: 0.7rem;
      }

      .info-note-desc {
        font-size: 0.76rem;
        line-height: 1.4;
      }

      .info-note-cta {
        margin-top: 8px !important;
        padding-top: 8px !important;
        gap: 6px !important;
      }

      .info-note-cta div {
        font-size: 0.74rem !important;
        line-height: 1.4 !important;
      }
    }

    @keyframes cf-spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    @keyframes cf-fade-in {
      from { opacity: 0; transform: translateY(5px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes ui-siren-pulse {
      0% { transform: scale(0.9); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 1; filter: drop-shadow(0 0 10px rgba(239, 68, 68, 0.6)); }
      100% { transform: scale(0.9); opacity: 0.8; }
    }
  </style>
