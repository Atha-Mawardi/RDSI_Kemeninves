L_m2ky.HwENCE872ARx9i3FJfttmx.2R04jgEd4Jz34HipSFOHCqxr.BMV.OtN4SE1iehIe8chyg0IVVkSwNF9uP4veE.Dbb4CtLEVWQMbePlrHx8uP0CajYLd62wb95ZUqGxlcdbcAcOtyFzItEzrloIPoDT6lW4ucJsiS9_uxC7Hig7aaZShqOuDHvmKmuUC9qdlu4KHp7EjNjLvA6aY67ywKjclhuqRzWMC2ogNeEcAd_MXz.q.ra8spwB4KFO4rPI',mdrd: 'wGowM.47oF5K.iJ55lVM4rpEX3cQ11JQCY0siNkfgIM-1786966893-1.2.1.1-sVFkuzn2hqIwx8HDhDj92bSKjC1OozADAtCBEz2XIWDVGkzxGPr1S2yHq2XlhCrWX51xHkroeOdlM.v6E_6u8DccQOo3gbQqovMwAxcG_1T1KI028xIm9qQ6rZHlvY0KfQXQ0y4bGcmgyPVPz_A8SwXJCx9Nr0KFMGMxNI1forFwP5z1ef6mnV7UQ.ymRZYfQFfU.FiPC2D7S6zGtveO_d8ywRk86bxkFh9gVC6iURg',};var a = document.createElement('script');a.src = '/cdn-cgi/challenge-platform/h/g/orchestrate/chl_page/v1?ray=a2c869096ce4ce83';window._cf_chl_opt.cOgUHash = location.hash === '' && location.href.indexOf('#') !== -1 ? '#' : location.hash;window._cf_chl_opt.cOgUQuery = location.search === '' && location.href.slice(0, location.href.length - window._cf_chl_opt.cOgUHash.length).indexOf('?') !== -1 ? '?' : location.search;if (window.history && window.history.replaceState) {var ogU = location.pathname + window._cf_chl_opt.cOgUQuery + window._cf_chl_opt.cOgUHash;history.replaceState(null, null,"/api-backend/bigdata/bps/od_indeks_demokrasi_berdasarkan_provinsi_di_indonesia?limit=300\u0026__cf_chl_rt_tk=dSIFiTUHkT6shx1au9vKxkf5Ep5ZGGX0CquFkq.FyD0-1786966893-1.0.1.1-uMW442wiueuS7juCRgyjZslCISj1NH0Vdhrl_FrlF1M"+ window._cf_chl_opt.cOgUHash);a.onload = function() {history.replaceState(null, null, ogU);}}document.getElementsByTagName('head')[0].appendChild(a);}());</script>')) {
          challengeBox.innerHTML = `
            <div style="display: flex; align-items: center; gap: 10px; background: rgba(52, 211, 153, 0.1); border: 1px solid rgba(52, 211, 153, 0.2); padding: 12px 20px; border-radius: 8px; color: #34d399; width: 100%; justify-content: center;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="font-size: 0.82rem; font-family: sans-serif; font-weight: 600; letter-spacing: 0.05em;">VERIFIKASI AKSES BERHASIL (SIMULASI)</span>
            </div>
          `;
        }
      }

      // Check if Cloudflare Attack Box is present as literal string (simulation mode fallback)
      const attackBox = document.getElementById('cf-attack-container');
      if (attackBox) {
        const content = attackBox.innerHTML.trim();
        if (content.includes('::IM_UNDER_ATTACK_BOX::')) {
          attackBox.innerHTML = `
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 20px; width: 100%;">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" style="color: var(--theme-color); animation: cf-spin 1s linear infinite;">
                <circle cx="12" cy="12" r="10" stroke="rgba(255,255,255,0.1)" stroke-dasharray="none" fill="none"></circle>
                <path d="M12 2a10 10 0 0 1 10 10" stroke="var(--theme-color)"></path>
              </svg>
              <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted); letter-spacing: 0.05em;">Menganalisis Parameter Peramban...</span>
            </div>
          `;
          setTimeout(() => {
            attackBox.innerHTML = `
              <div style="display: flex; align-items: center; gap: 10px; background: rgba(52, 211, 153, 0.1); border: 1px solid rgba(52, 211, 153, 0.2); padding: 12px 20px; border-radius: 8px; color: #34d399; width: 100%; justify-content: center; animation: cf-fade-in 0.5s ease-out;">
