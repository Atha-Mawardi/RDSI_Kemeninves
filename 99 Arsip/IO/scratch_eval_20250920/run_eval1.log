. * ===========================================================================
> ==
. * 7. COEF FGLS → csv (bukan 5 estimator)
. * ===========================================================================
> ==
. 
. tempname H

. postfile `H' str40 model str40 var float b se t p n using "${outdir}/eval1_co
> ef.dta", replace

. 
. foreach m in ///
>         FGLS_pendidikan FGLS_equity FGLS_institusi FGLS_konektivitas FGLS_lin
> gkungan FGLS_keamanan ///
>         FGLS_crs_pendidikan FGLS_crs_equity FGLS_crs_institusi FGLS_crs_konek
> tivitas FGLS_crs_lingkungan FGLS_crs_keamanan ///
>         FGLS_hijau_biru FGLS_hijau_ekstr FGLS_tfp_hijau_ekstr FGLS_gini_ipm /
> //
>         FGLS_pad_belanja FGLS_tk FGLS_inv FGLS_sawit FGLS_hijau_tk FGLS_eq_fi
> skal_tk ///
>         FGLS FE RE RE2W {
  2.         capture noisily estimates restore `m'
  3.         if _rc continue
  4.         quietly count if e(sample)
  5.         local n = r(N)
  6.         local vars : colnames e(b)
  7.         foreach v of local vars {
  8.                 if "`v'" == "_cons" continue
  9.                 if strpos("`v'", "Year") continue
 10.                 capture {
 11.                         local bi = _b[`v']
 12.                         local se = _se[`v']
 13.                         local tt = `bi' / `se'
 14.                         local pp = 2 * (1 - normal(abs(`tt')))
 15.                         post `H' ("`m'") ("`v'") (`bi') (`se') (`tt') (`pp
> ') (`n')
 16.                 }
 17.         }
 18. }
