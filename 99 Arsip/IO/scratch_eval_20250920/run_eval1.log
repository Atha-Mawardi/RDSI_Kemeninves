. local secs A B C D E F G H I J K L MN O P Q RSTU

. egen double tk_total = rowtotal(*_TenagaKerja)

. foreach s of local secs {
  2.         rename `s'_TenagaKerja tk_`s'
  3.         gen double ln_upah_`s' = ln(upah_`s' + 1)
  4.         gen double wagebill_`s' = upah_`s' * tk_`s'
  5.         gen double inv_`s' = `s'_PMA + `s'_PMDN
  6.         replace inv_`s' = 0 if missing(inv_`s') | inv_`s' < 0
  7.         gen double share_tk_`s'    = tk_`s' / tk_total
  8.         gen double share_pdrb_`s'  = `s'_ADHK / pdrb_adhk
  9.         gen double share_inv_`s'   = .
 10. }
