. postfile mor str16 var str8 W float I p N using "${outdir}/eval2_moran.dta", 
> replace

. foreach v in logtfp_it logtfp_it_crs pilar_pendidikan pilar_equity ///
>         pilar_institusi pilar_konektivitas pilar_lingkungan pilar_keamanan //
> /
>         idx_solow idx_fiskal indeks_hijau rasio_pad share_tk_primer {
  2.         foreach w in Wq Wi {
  3.                 if "`w'" == "Wq" {
  4.                         if inlist("`v'", "pilar_pendidikan", "pilar_equity
> ", "pilar_institusi", ///
>                                 "pilar_konektivitas", "pilar_lingkungan", "pi
> lar_keamanan") {
  5.                                 local wv Wq_`v'
  6.                         }
  7.                         else local wv Wq_`v'
  8.                 }
  9.                 else {
 10.                         capture confirm variable Wi_`v'
 11.                         if _rc continue
 12.                         local wv Wi_`v'
 13.                 }
 14.                 capture confirm variable `wv'
 15.                 if _rc continue
 16.                 quietly summarize `v'
 17.                 local n = r(N)
 18.                 quietly correlate `v' `wv'
 19.                 local I = r(rho)
 20.                 quietly regress `v' `wv'
 21.                 local p = 2 * ttail(e(df_r), abs(_b[`wv']/_se[`wv']))
 22.                 post mor ("`v'") ("`w'") (`I') (`p') (`n')
 23.         }
 24. }

. postclose mor

