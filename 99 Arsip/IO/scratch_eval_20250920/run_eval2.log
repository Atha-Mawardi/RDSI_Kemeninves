  8.         if inlist("`v'", "pilar_pendidikan", "pilar_equity", "pilar_instit
> usi", ///
>                 "pilar_konektivitas", "pilar_lingkungan", "pilar_keamanan") {
  9.                 local wv Wq_`v'
 10.         }
 11.         capture confirm variable `wv'
 12.         if _rc continue
 13.         quietly summarize `v', detail
 14.         local med = r(p50)
 15.         quietly summarize `wv', detail
 16.         local medw = r(p50)
 17.         gen str8 lisa_`v' = "LH"
 18.         replace lisa_`v' = "HH" if `v' >= `med' & `wv' >= `medw'
 19.         replace lisa_`v' = "LL" if `v' <  `med' & `wv' <  `medw'
 20.         replace lisa_`v' = "HL" if `v' >= `med' & `wv' <  `medw'
 21.         replace lisa_`v' = "LH" if `v' <  `med' & `wv' >= `medw'
 22. }
