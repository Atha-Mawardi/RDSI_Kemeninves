. tempname H

. postfile `H' str40 model str40 var float b se t p n using "${outdir}/eval2_co
> ef.dta", replace

. 
. foreach m in ///
>         FGLS_K_pendidikan FGLS_K_equity FGLS_K_institusi FGLS_K_konektivitas 
> FGLS_K_keamanan ///
>         FGLS_L_pendidikan FGLS_L_equity FGLS_L_institusi FGLS_L_konektivitas 
> FGLS_L_keamanan ///
>         FGLS_inv_pk FGLS_inv_sektor FGLS_inv_dom FGLS_invC_tkC FGLS_hijinv FG
> LS_sawit ///
>         FGLS_pad_belanja FGLS_SLX_fiskal_q FGLS_SLX_fiskal_i ///
>         FGLS_SLX_pend_q FGLS_SLX_eq_q FGLS_SLX_inst_q FGLS_SLX_crs_fiskal ///
>         FGLS_kantong FGLS_kantong_crs {
  2.         capture noisily estimates restore `m'
  3.         if _rc continue
  4.         quietly count if e(sample)
  5.         local n = r(N)
  6.         local vars : colnames e(b)
  7.         foreach v of local vars {
  8.                 if "`v'" == "_cons" continue
  9.                 capture {
 10.                         local bi = _b[`v']
 11.                         local se = _se[`v']
 12.                         local tt = `bi' / `se'
 13.                         local pp = 2 * (1 - normal(abs(`tt')))
 14.                         post `H' ("`m'") ("`v'") (`bi') (`se') (`tt') (`pp
> ') (`n')
 15.                 }
 16.         }
 17. }
